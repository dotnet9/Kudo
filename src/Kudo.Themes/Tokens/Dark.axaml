<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="KudoInputPortBrush" Color="#69F0AE" />
    <SolidColorBrush x:Key="KudoOutputPortBrush" Color="#FFD166" />
    <SolidColorBrush x:Key="KudoBidirectionalPortBrush" Color="#E879F9" />
        <StaticResource x:Key="KudoInvalidPortFillBrush" ResourceKey="SemiColorDangerLight" />
    <StaticResource x:Key="KudoInvalidPortStrokeBrush" ResourceKey="SemiColorDanger" />
    <StaticResource x:Key="KudoDescriptionBrush" ResourceKey="SemiColorText2" />
                    </ResourceDictionary>
