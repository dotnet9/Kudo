<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="KudoInputPortBrush" Color="#00C853" />
    <SolidColorBrush x:Key="KudoOutputPortBrush" Color="#FFB300" />
    <SolidColorBrush x:Key="KudoBidirectionalPortBrush" Color="#D946EF" />
        <StaticResource x:Key="KudoInvalidPortFillBrush" ResourceKey="SemiColorDangerLight" />
    <StaticResource x:Key="KudoInvalidPortStrokeBrush" ResourceKey="SemiColorDanger" />
    <StaticResource x:Key="KudoDescriptionBrush" ResourceKey="SemiColorText2" />
                    </ResourceDictionary>
