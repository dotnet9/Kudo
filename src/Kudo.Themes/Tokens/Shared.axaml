<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="KudoPropertiesFontSize">12</x:Double>
    <x:Double x:Key="KudoPortGlyphRadius">7</x:Double>
    <x:Double x:Key="KudoActivePortGlyphRadius">8.5</x:Double>
    <x:Double x:Key="KudoPortCandidateRadius">11</x:Double>
    <x:Double x:Key="KudoPortHighlightPadding">7</x:Double>
    <x:Double x:Key="KudoPortLabelFontSize">11</x:Double>
    <x:Double x:Key="KudoPortLabelOffset">10</x:Double>
    <x:Double x:Key="KudoSymbolNameOffset">6</x:Double>
    <x:Double x:Key="KudoSymbolDescriptionOffset">6</x:Double>
    <x:Double x:Key="KudoSymbolDescriptionFontScale">0.86</x:Double>
    <x:Double x:Key="KudoPortDisabledOpacity">0.35</x:Double>
    <x:Double x:Key="KudoPortHighlightOpacity">0.16</x:Double>
    <x:Double x:Key="KudoInvalidPortHighlightOpacity">0.2</x:Double>
    <x:Double x:Key="KudoActivePortStrokeThickness">2.5</x:Double>
    <x:Double x:Key="KudoPortGlyphStrokeThickness">2</x:Double>
    <x:Double x:Key="KudoInvalidPortStrokeThickness">1.5</x:Double>
    <x:Double x:Key="KudoInputOutputPortGlyphOffsetFactor">0.42</x:Double>
    <x:Double x:Key="KudoInputOutputPortGlyphScale">0.72</x:Double>
    <x:Double x:Key="KudoPortChevronHalfWidthFactor">0.55</x:Double>
    <x:Double x:Key="KudoPortHitRadius">10</x:Double>
    <SolidColorBrush x:Key="KudoMinimapViewportFillBrush" Color="#302AA58F" />
</ResourceDictionary>
