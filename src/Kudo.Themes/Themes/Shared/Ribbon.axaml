<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   >
  <x:Double x:Key="RibbonIconSlotSize">28</x:Double>
  <x:Double x:Key="RibbonIconSize">24</x:Double>
  <x:Double x:Key="RibbonDropDownGlyphSize">9</x:Double>
  <x:Double x:Key="RibbonMenuIconSize">16</x:Double>
  <x:Double x:Key="RibbonMenuItemIconSize">24</x:Double>
  <x:Double x:Key="RibbonMenuTabStripHeight">32</x:Double>
  <x:Double x:Key="RibbonMenuContentHeight">74</x:Double>

  <CornerRadius x:Key="RibbonMenuTabsCornerRadius">8,8,0,0</CornerRadius>
  <CornerRadius x:Key="RibbonMenuTabHeaderCornerRadius">10,10,0,0</CornerRadius>
  <Thickness x:Key="RibbonMenuTabHeaderPadding">20,5,20,3</Thickness>
  <x:Double x:Key="RibbonMenuTabHeaderFontSize">14</x:Double>
  <x:Double x:Key="RibbonMenuTabHeaderMinWidth">128</x:Double>
  <Thickness x:Key="RibbonMenuTabHeaderBorderThickness">0</Thickness>
  <Thickness x:Key="RibbonMenuContentMargin">5,0,0,0</Thickness>

  <LinearGradientBrush x:Key="RibbonMenuTabStripBackground" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Color="#58D6F2E5" Offset="0" />
    <GradientStop Color="#80BCD8CE" Offset="0.55" />
    <GradientStop Color="#80FFFFFF" Offset="1" />
  </LinearGradientBrush>

  <Thickness x:Key="RibbonGroupMargin">0,2</Thickness>
  <x:Double x:Key="RibbonGroupHeight">70</x:Double>

  <x:Double x:Key="RibbonCommandHeight">58</x:Double>
  <x:Double x:Key="RibbonCommandMinWidth">60</x:Double>
  <x:Double x:Key="RibbonCommandDropDownMinWidth">66</x:Double>
  <x:Double x:Key="RibbonCommandFontSize">12</x:Double>
  <Thickness x:Key="RibbonCommandMargin">3,5,3,1</Thickness>
  <Thickness x:Key="RibbonCommandPadding">5,4</Thickness>
  <CornerRadius x:Key="RibbonCommandCornerRadius">4</CornerRadius>
  <x:Double x:Key="RibbonCommandDisabledOpacity">0.46</x:Double>
  <x:Double x:Key="RibbonSmallCommandHeight">29</x:Double>
  <x:Double x:Key="RibbonSmallCommandMinWidth">52</x:Double>
  <Thickness x:Key="RibbonSmallCommandPadding">5,2</Thickness>
  <CornerRadius x:Key="RibbonSmallCommandCornerRadius">3</CornerRadius>
  <x:Double x:Key="RibbonSmallCommandIconSlotSize">18</x:Double>
  <x:Double x:Key="RibbonCompactCommandWidth">30</x:Double>
  <x:Double x:Key="RibbonCompactCommandHeight">29</x:Double>
  <Thickness x:Key="RibbonCompactCommandPadding">0</Thickness>
  <CornerRadius x:Key="RibbonCompactCommandCornerRadius">3</CornerRadius>

  <Thickness x:Key="RibbonDropDownGlyphMargin">-4,0,3,0</Thickness>
  <x:Double x:Key="RibbonDropDownGlyphOpacity">0.78</x:Double>

  <x:Double x:Key="RibbonFlyoutMinWidth">136</x:Double>
  <Thickness x:Key="RibbonFlyoutPadding">4</Thickness>
  <Thickness x:Key="RibbonFlyoutBorderThickness">1</Thickness>
  <CornerRadius x:Key="RibbonFlyoutCornerRadius">6</CornerRadius>
  <x:Double x:Key="RibbonFlyoutItemMinHeight">32</x:Double>
  <Thickness x:Key="RibbonFlyoutItemPadding">10,6,12,6</Thickness>
  <CornerRadius x:Key="RibbonFlyoutItemCornerRadius">5</CornerRadius>
  <Thickness x:Key="RibbonDividerMargin">5,12,5,12</Thickness>
  <x:Double x:Key="RibbonDividerOpacity">0.45</x:Double>
  <Thickness x:Key="RibbonGroupDividerMargin">0,12</Thickness>

  <Thickness x:Key="RibbonFieldColumnsMargin">6,2,6,0</Thickness>
  <x:Double x:Key="RibbonFieldColumnsRowSpacing">4</x:Double>
  <x:Double x:Key="RibbonFieldInputWidth">96</x:Double>
  <x:Double x:Key="RibbonFieldInputHeight">24</x:Double>
  <Thickness x:Key="RibbonFieldInputPadding">8,2</Thickness>
  <Thickness x:Key="RibbonFieldNumericPadding">4,2</Thickness>
  <CornerRadius x:Key="RibbonFieldInputCornerRadius">4</CornerRadius>
  <x:Double x:Key="RibbonFieldNumericFontSize">11</x:Double>
  <x:Double x:Key="RibbonFieldCheckBoxHeight">29</x:Double>
  <x:Double x:Key="RibbonFieldCheckBoxMinWidth">78</x:Double>
  <Thickness x:Key="RibbonFieldCheckBoxPadding">2,0</Thickness>
  <x:Double x:Key="RibbonFieldCheckBoxFontSize">11</x:Double>
  <Thickness x:Key="RibbonFieldCheckBoxMargin">2,0</Thickness>

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="RibbonMenuTabHeaderForeground" Color="#F0F8F5" />
      <SolidColorBrush x:Key="RibbonMenuTabHeaderPointeroverForeground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="RibbonMenuTabHeaderPointeroverBackground" Color="#18FFFFFF" />
      <SolidColorBrush x:Key="RibbonMenuTabHeaderSelectedForeground" Color="#0A8573" />
      <SolidColorBrush x:Key="RibbonMenuTabHeaderSelectedBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="RibbonMenuTabHeaderStartSelectedBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="RibbonMenuTabHeaderEndSelectedBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="RibbonFieldLabelForeground" Color="#262626" />
      <SolidColorBrush x:Key="RibbonFieldInputBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="RibbonFieldInputBorderBrush" Color="#C4DAD4" />
      <SolidColorBrush x:Key="RibbonFieldInputFocusBorderBrush" Color="#0E9F8A" />
      <SolidColorBrush x:Key="RibbonFieldInputForeground" Color="#1F2E2A" />
      <SolidColorBrush x:Key="RibbonFieldInputDisabledBackground" Color="#F5F5F5" />
      <SolidColorBrush x:Key="RibbonFieldInputDisabledBorderBrush" Color="#D9D9D9" />
      <SolidColorBrush x:Key="RibbonFieldInputDisabledForeground" Color="#AEB8C5" />
      <SolidColorBrush x:Key="RibbonCommandForeground" Color="#22362F" />
      <SolidColorBrush x:Key="RibbonCommandPointeroverBackground" Color="#E9F6F1" />
      <SolidColorBrush x:Key="RibbonCommandPointeroverForeground" Color="#0A8B77" />
      <SolidColorBrush x:Key="RibbonCommandPressedBackground" Color="#D8F0E9" />
      <SolidColorBrush x:Key="RibbonCommandPressedForeground" Color="#085F53" />
      <SolidColorBrush x:Key="RibbonFlyoutBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="RibbonFlyoutBorderBrush" Color="#CFE2DC" />
      <SolidColorBrush x:Key="RibbonMenuIconForeground" Color="#12997E" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="RibbonMenuTabHeaderForeground" Color="#F0F8F5" />
      <SolidColorBrush x:Key="RibbonMenuTabHeaderPointeroverForeground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="RibbonMenuTabHeaderPointeroverBackground" Color="#18FFFFFF" />
      <SolidColorBrush x:Key="RibbonMenuTabHeaderSelectedForeground" Color="#0A8573" />
      <SolidColorBrush x:Key="RibbonMenuTabHeaderSelectedBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="RibbonMenuTabHeaderStartSelectedBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="RibbonMenuTabHeaderEndSelectedBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="RibbonFieldLabelForeground" Color="#262626" />
      <SolidColorBrush x:Key="RibbonFieldInputBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="RibbonFieldInputBorderBrush" Color="#C4DAD4" />
      <SolidColorBrush x:Key="RibbonFieldInputFocusBorderBrush" Color="#0E9F8A" />
      <SolidColorBrush x:Key="RibbonFieldInputForeground" Color="#1F2E2A" />
      <SolidColorBrush x:Key="RibbonFieldInputDisabledBackground" Color="#F5F5F5" />
      <SolidColorBrush x:Key="RibbonFieldInputDisabledBorderBrush" Color="#D9D9D9" />
      <SolidColorBrush x:Key="RibbonFieldInputDisabledForeground" Color="#AEB8C5" />
      <SolidColorBrush x:Key="RibbonCommandForeground" Color="#22362F" />
      <SolidColorBrush x:Key="RibbonCommandPointeroverBackground" Color="#E9F6F1" />
      <SolidColorBrush x:Key="RibbonCommandPointeroverForeground" Color="#0A8B77" />
      <SolidColorBrush x:Key="RibbonCommandPressedBackground" Color="#D8F0E9" />
      <SolidColorBrush x:Key="RibbonCommandPressedForeground" Color="#085F53" />
      <SolidColorBrush x:Key="RibbonFlyoutBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="RibbonFlyoutBorderBrush" Color="#CFE2DC" />
      <SolidColorBrush x:Key="RibbonMenuIconForeground" Color="#12997E" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="RibbonMenuTabHeaderForeground" Color="#DCE9E4" />
      <SolidColorBrush x:Key="RibbonMenuTabHeaderPointeroverForeground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="RibbonMenuTabHeaderPointeroverBackground" Color="#24FFFFFF" />
      <SolidColorBrush x:Key="RibbonMenuTabHeaderSelectedForeground" Color="#6FD9C3" />
      <SolidColorBrush x:Key="RibbonMenuTabHeaderSelectedBackground" Color="#16211D" />
      <SolidColorBrush x:Key="RibbonMenuTabHeaderStartSelectedBackground" Color="#16211D" />
      <SolidColorBrush x:Key="RibbonMenuTabHeaderEndSelectedBackground" Color="#16211D" />
      <SolidColorBrush x:Key="RibbonFieldLabelForeground" Color="#B7CFC7" />
      <SolidColorBrush x:Key="RibbonFieldInputBackground" Color="#16211D" />
      <SolidColorBrush x:Key="RibbonFieldInputBorderBrush" Color="#2B4038" />
      <SolidColorBrush x:Key="RibbonFieldInputFocusBorderBrush" Color="#52C7AF" />
      <SolidColorBrush x:Key="RibbonFieldInputForeground" Color="#DCE9E4" />
      <SolidColorBrush x:Key="RibbonFieldInputDisabledBackground" Color="#1F2B27" />
      <SolidColorBrush x:Key="RibbonFieldInputDisabledBorderBrush" Color="#364A42" />
      <SolidColorBrush x:Key="RibbonFieldInputDisabledForeground" Color="#5F736B" />
      <SolidColorBrush x:Key="RibbonCommandForeground" Color="#DCE9E4" />
      <SolidColorBrush x:Key="RibbonCommandPointeroverBackground" Color="#1C3830" />
      <SolidColorBrush x:Key="RibbonCommandPointeroverForeground" Color="#6FD9C3" />
      <SolidColorBrush x:Key="RibbonCommandPressedBackground" Color="#224439" />
      <SolidColorBrush x:Key="RibbonCommandPressedForeground" Color="#A8E6D6" />
      <SolidColorBrush x:Key="RibbonFlyoutBackground" Color="#16211D" />
      <SolidColorBrush x:Key="RibbonFlyoutBorderBrush" Color="#2B4038" />
      <SolidColorBrush x:Key="RibbonMenuIconForeground" Color="#52C7AF" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
