<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StaticResource x:Key="DataGridColumnHeaderForeground" ResourceKey="SemiColorText0" />
  <SolidColorBrush x:Key="DataGridColumnHeaderBackground">#FAFAFA</SolidColorBrush>
  <StaticResource x:Key="DataGridRowPointeroverBackground" ResourceKey="SemiColorFill1" />

  <!-- 表格行选中态，供设备客户端所有 DataGrid 共用。 -->
  <StaticResource x:Key="DataGridRowSelectedBackground" ResourceKey="SemiColorPrimaryLight" />
  <StaticResource x:Key="DataGridRowSelectedPointeroverBackground" ResourceKey="SemiColorPrimaryLightPointerover" />
  <StaticResource x:Key="DataGridRowSelectedForeground" ResourceKey="SemiColorText0" />

  <!-- Semi 的文本列会给生成的 TextBlock 设置 Margin；列头和编辑控件必须使用同一内容基线。 -->
  <Thickness x:Key="DataGridCellTextBlockDefaultMargin">10,0</Thickness>
  <Thickness x:Key="DataGridCellEditorPadding">10,0</Thickness>
  <Thickness x:Key="DataGridColumnHeaderPadding">10,0,0,0</Thickness>
  <!-- 主数据表与详情表使用两套固定密度；默认表格按主数据表展示。 -->
  <x:Double x:Key="DataGridLargeHeight">30</x:Double>
  <x:Double x:Key="DataGridSmallHeight">28</x:Double>
  <StaticResource x:Key="DataGridLargeFontSize" ResourceKey="Kudo.Typography.Body.FontSize" />
  <StaticResource x:Key="DataGridSmallFontSize" ResourceKey="Kudo.Typography.Caption.FontSize" />
  <!-- 保留原资源键，供现有表格内编辑控件继续跟随默认大表格高度。 -->
  <StaticResource x:Key="DataGridDefaultMinHeight" ResourceKey="DataGridLargeHeight" />
</ResourceDictionary>
