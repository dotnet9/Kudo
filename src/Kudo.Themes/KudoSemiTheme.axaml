<Styles x:Class="Kudo.Themes.KudoSemiTheme"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:k="https://codewf.com"
        xmlns:semi="https://irihi.tech/semi">
    <semi:ColorPickerSemiTheme />
    <StyleInclude Source="avares://Kudo.Themes/Styles/GraphNodePalette.axaml" />
    <StyleInclude Source="avares://Kudo.Themes/Styles/GraphPropertiesView.axaml" />
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude x:Key="Default" Source="avares://Kudo.Themes/Tokens/Light.axaml" />
                <ResourceInclude x:Key="Light" Source="avares://Kudo.Themes/Tokens/Light.axaml" />
                <ResourceInclude x:Key="Dark" Source="avares://Kudo.Themes/Tokens/Dark.axaml" />
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Kudo.Themes/Tokens/Shared.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
    <Style Selector="k|GraphCanvas">
        <Setter Property="IsLevelOfDetailEnabled" Value="True" />
        <Setter Property="LodPortsZoomThreshold" Value="0.4" />
        <Setter Property="LodLabelsZoomThreshold" Value="0.3" />
        <Setter Property="LodSimplifiedZoomThreshold" Value="0.4" />
        <Setter Property="CanvasBackgroundBrush" Value="{DynamicResource SemiColorBackground0}" />
        <Setter Property="NodeFillBrush" Value="{DynamicResource SemiColorBackground1}" />
        <Setter Property="NodeStrokeBrush" Value="{DynamicResource SemiColorText3}" />
        <Setter Property="SelectedNodeStrokeBrush" Value="{DynamicResource SemiColorPrimary}" />
        <Setter Property="GroupFillBrush" Value="{DynamicResource KudoGroupFillBrush}" />
        <Setter Property="GroupHeaderFillBrush" Value="{DynamicResource KudoGroupHeaderFillBrush}" />
        <Setter Property="GroupStrokeBrush" Value="{DynamicResource SemiColorPrimaryLightActive}" />
        <Setter Property="SelectedGroupStrokeBrush" Value="{DynamicResource SemiColorPrimary}" />
        <Setter Property="GroupTitleBrush" Value="{DynamicResource SemiColorText1}" />
        <Setter Property="AnnotationFillBrush" Value="{DynamicResource SemiColorWarningLight}" />
        <Setter Property="AnnotationStrokeBrush" Value="{DynamicResource SemiColorWarningLightActive}" />
        <Setter Property="SelectedAnnotationStrokeBrush" Value="{DynamicResource SemiColorPrimary}" />
        <Setter Property="AnnotationTextBrush" Value="{DynamicResource SemiColorText0}" />
        <Setter Property="RuntimeActiveBrush" Value="{DynamicResource SemiColorSuccess}" />
        <Setter Property="EdgeBrush" Value="{DynamicResource SemiColorPrimary}" />
        <Setter Property="SelectedEdgeBrush" Value="{DynamicResource SemiColorWarning}" />
        <Setter Property="RuntimeSignalBrush" Value="{DynamicResource SemiColorSuccess}" />
        <Setter Property="OverlayStrokeBrush" Value="{DynamicResource SemiColorBackground1}" />
        <Setter Property="RuntimeRunningNodeFillBrush" Value="{DynamicResource SemiColorSuccessLight}" />
        <Setter Property="RuntimePausedNodeFillBrush" Value="{DynamicResource SemiColorWarningLight}" />
        <Setter Property="RuntimeFaultedNodeFillBrush" Value="{DynamicResource SemiColorDangerLight}" />
        <Setter Property="EdgeLabelFillBrush" Value="{DynamicResource SemiColorBackground1}" />
        <Setter Property="EdgeLabelTextBrush" Value="{DynamicResource SemiColorText0}" />
        <Setter Property="EdgeLabelStrokeBrush" Value="{DynamicResource SemiColorBorder}" />
        <Setter Property="InputPortBrush" Value="{DynamicResource KudoInputPortBrush}" />
        <Setter Property="OutputPortBrush" Value="{DynamicResource KudoOutputPortBrush}" />
        <Setter Property="BidirectionalPortBrush" Value="{DynamicResource KudoBidirectionalPortBrush}" />
        <Setter Property="ReferencePortBrush" Value="{DynamicResource KudoReferencePortBrush}" />
        <Setter Property="InvalidPortFillBrush" Value="{DynamicResource KudoInvalidPortFillBrush}" />
        <Setter Property="InvalidPortStrokeBrush" Value="{DynamicResource KudoInvalidPortStrokeBrush}" />
        <Setter Property="PortGlyphRadius" Value="{DynamicResource KudoPortGlyphRadius}" />
        <Setter Property="ActivePortGlyphRadius" Value="{DynamicResource KudoActivePortGlyphRadius}" />
        <Setter Property="PortCandidateRadius" Value="{DynamicResource KudoPortCandidateRadius}" />
        <Setter Property="PortHighlightPadding" Value="{DynamicResource KudoPortHighlightPadding}" />
        <Setter Property="PortLabelFontSize" Value="{DynamicResource KudoPortLabelFontSize}" />
        <Setter Property="PortLabelOffset" Value="{DynamicResource KudoPortLabelOffset}" />
        <Setter Property="SymbolNameOffset" Value="{DynamicResource KudoSymbolNameOffset}" />
        <Setter Property="SymbolDescriptionOffset" Value="{DynamicResource KudoSymbolDescriptionOffset}" />
        <Setter Property="SymbolDescriptionFontScale" Value="{DynamicResource KudoSymbolDescriptionFontScale}" />
        <Setter Property="PortDisabledOpacity" Value="{DynamicResource KudoPortDisabledOpacity}" />
        <Setter Property="PortHighlightOpacity" Value="{DynamicResource KudoPortHighlightOpacity}" />
        <Setter Property="InvalidPortHighlightOpacity" Value="{DynamicResource KudoInvalidPortHighlightOpacity}" />
        <Setter Property="ActivePortStrokeThickness" Value="{DynamicResource KudoActivePortStrokeThickness}" />
        <Setter Property="PortGlyphStrokeThickness" Value="{DynamicResource KudoPortGlyphStrokeThickness}" />
        <Setter Property="InvalidPortStrokeThickness" Value="{DynamicResource KudoInvalidPortStrokeThickness}" />
        <Setter Property="InputOutputPortGlyphOffsetFactor" Value="{DynamicResource KudoInputOutputPortGlyphOffsetFactor}" />
        <Setter Property="InputOutputPortGlyphScale" Value="{DynamicResource KudoInputOutputPortGlyphScale}" />
        <Setter Property="PortChevronHalfWidthFactor" Value="{DynamicResource KudoPortChevronHalfWidthFactor}" />
        <Setter Property="PortHitRadius" Value="{DynamicResource KudoPortHitRadius}" />
        <Setter Property="TitleBrush" Value="{DynamicResource SemiColorText0}" />
        <Setter Property="DescriptionBrush" Value="{DynamicResource KudoDescriptionBrush}" />
        <Setter Property="PortTextBrush" Value="{DynamicResource SemiColorText2}" />
        <Setter Property="SelectionFillBrush" Value="{DynamicResource KudoSelectionFillBrush}" />
        <Setter Property="GridMinorBrush" Value="{DynamicResource SemiColorBorder}" />
        <Setter Property="GridMajorBrush" Value="{DynamicResource SemiColorText3}" />
        <Setter Property="AlignmentGuideBrush" Value="{DynamicResource SemiColorWarning}" />
        <Setter Property="PlacementPreviewFillBrush" Value="{DynamicResource SemiColorPrimaryLight}" />
        <Setter Property="InvalidPlacementPreviewFillBrush" Value="{DynamicResource SemiColorDangerLight}" />
        <Setter Property="DangerBrush" Value="{DynamicResource SemiColorDanger}" />
    </Style>
    <Style Selector="k|GraphMinimap">
        <Setter Property="BackgroundBrush" Value="{DynamicResource SemiColorBackground1}" />
        <Setter Property="NodeBrush" Value="{DynamicResource SemiColorText3}" />
        <Setter Property="SelectedNodeBrush" Value="{DynamicResource SemiColorPrimary}" />
        <Setter Property="GroupBrush" Value="{DynamicResource KudoMinimapGroupBrush}" />
        <Setter Property="SelectedGroupBrush" Value="{DynamicResource KudoMinimapSelectedGroupBrush}" />
        <Setter Property="EdgeBrush" Value="{DynamicResource SemiColorPrimary}" />
        <Setter Property="ViewportFillBrush" Value="{DynamicResource KudoMinimapViewportFillBrush}" />
        <Setter Property="ViewportStrokeBrush" Value="{DynamicResource SemiColorPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
    </Style>
    <Style Selector="k|GraphRuler">
        <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
        <Setter Property="MinorTickBrush" Value="{DynamicResource SemiColorBorder}" />
        <Setter Property="MajorTickBrush" Value="{DynamicResource SemiColorText3}" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
    </Style>
    <Style Selector="k|GraphDesignerPanel">
        <Setter Property="PanelBrush" Value="{DynamicResource SemiColorBackground1}" />
        <Setter Property="ElevatedBrush" Value="{DynamicResource SemiColorFill0}" />
        <Setter Property="DividerBrush" Value="{DynamicResource SemiColorBorder}" />
        <Setter Property="PrimaryTextBrush" Value="{DynamicResource SemiColorText0}" />
        <Setter Property="SecondaryTextBrush" Value="{DynamicResource SemiColorText2}" />
        <Setter Property="AccentBrush" Value="{DynamicResource SemiColorPrimary}" />
        <Setter Property="SuccessBrush" Value="{DynamicResource SemiColorSuccess}" />
        <Setter Property="WarningBrush" Value="{DynamicResource SemiColorWarning}" />
        <Setter Property="ErrorBrush" Value="{DynamicResource SemiColorDanger}" />
    </Style>
</Styles>
