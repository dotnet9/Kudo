<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:codewf="https://codewf.com">
  <Style Selector="TextBlock.AppDialogTitle">
    <Setter Property="Margin" Value="{StaticResource Kudo.Dialog.Title.Margin}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{StaticResource NotoSansSC}" />
    <Setter Property="Foreground" Value="#262626" />
    <Setter Property="FontWeight" Value="{DynamicResource Kudo.Typography.Strong.FontWeight}" />
    <Setter Property="FontSize" Value="{StaticResource Kudo.Dialog.Title.FontSize}" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="TextBlock.AppDialogTitle.Large">
    <Setter Property="Margin" Value="{StaticResource Kudo.Dialog.Title.Margin}" />
    <Setter Property="FontFamily" Value="{StaticResource NotoSansSC}" />
    <Setter Property="Foreground" Value="#262626" />
    <Setter Property="FontWeight" Value="{DynamicResource Kudo.Typography.Strong.FontWeight}" />
    <Setter Property="FontSize" Value="{StaticResource Kudo.Dialog.Title.FontSize}" />
    <Setter Property="LineHeight" Value="16" />
  </Style>
  <Style Selector="TextBlock.AppDialogMutedLabel">
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
    <Setter Property="FontSize" Value="{StaticResource Kudo.Typography.Form.FontSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="SelectableTextBlock.AppDialogValue">
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
    <Setter Property="FontSize" Value="{StaticResource Kudo.Typography.Form.FontSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.ValidationMessage">
    <Setter Property="Foreground" Value="{DynamicResource DataValidationErrorsForeground}" />
    <Setter Property="FontSize" Value="{StaticResource Kudo.Typography.Caption.FontSize}" />
  </Style>
  <Style Selector="Border.AppDialogHeader">
    <Setter Property="Background" Value="{DynamicResource Kudo.Dialog.Header.Background}" />
    <Setter Property="CornerRadius" Value="{StaticResource ShellTopCornerRadius}" />
  </Style>
</Styles>
