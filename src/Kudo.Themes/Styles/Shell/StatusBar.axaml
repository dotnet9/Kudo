<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:codewf="https://codewf.com" xmlns:u="https://irihi.tech/ursa">
  <Style Selector="Border.TaskBarRoot">
    <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
    <Setter Property="BorderThickness" Value="{StaticResource TaskBarBorderThickness}" />
  </Style>
  <Style Selector="Grid.TaskBarLayout">
    <Setter Property="Height" Value="{StaticResource TaskBarHeight}" />
  </Style>
  <Style Selector="StackPanel.TaskBarLeftItems">
    <Setter Property="Margin" Value="{StaticResource TaskBarLeftItemsMargin}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="StackPanel.TaskBarStatusItems">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="TextBlock.TaskBarItemHeader">
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
    <Setter Property="FontSize" Value="{StaticResource Kudo.Typography.Caption.FontSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Margin" Value="{StaticResource TaskBarItemHeaderMargin}" />
  </Style>
  <Style Selector="TextBlock.TaskBarItemValue">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
    <Setter Property="FontSize" Value="{StaticResource Kudo.Typography.Caption.FontSize}" />
    <Setter Property="Margin" Value="{StaticResource TaskBarItemValueMargin}" />
  </Style>
  <Style Selector="Border.TaskBarStatusPill">
    <Setter Property="Height" Value="{StaticResource TaskBarStatusPillHeight}" />
    <Setter Property="Padding" Value="{StaticResource TaskBarStatusPillPadding}" />
    <Setter Property="Margin" Value="{StaticResource TaskBarStatusPillMargin}" />
    <Setter Property="Background" Value="{DynamicResource SemiColorBackground0}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource TaskBarStatusPillCornerRadius}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.TaskBarStatusPill.Online">
    <Setter Property="Background" Value="{DynamicResource SemiColorSuccessLight}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SemiColorSuccessLightPointerover}" />
  </Style>
  <Style Selector="Border.TaskBarStatusIconSlot">
    <Setter Property="Width" Value="{StaticResource TaskBarStatusIconSlotSize}" />
    <Setter Property="Height" Value="{StaticResource TaskBarStatusIconSlotSize}" />
    <Setter Property="Margin" Value="{StaticResource TaskBarStatusIconSlotMargin}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="PathIcon.TaskBarStatusIcon">
    <Setter Property="Theme" Value="{StaticResource InnerPathIcon}" />
    <Setter Property="Width" Value="{StaticResource TaskBarStatusIconSize}" />
    <Setter Property="Height" Value="{StaticResource TaskBarStatusIconSize}" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorDanger}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="PathIcon.TaskBarStatusIcon.Online">
    <Setter Property="Foreground" Value="{DynamicResource SemiColorSuccess}" />
  </Style>
  <Style Selector="TextBlock.TaskBarStatusName">
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
    <Setter Property="FontSize" Value="{StaticResource Kudo.Typography.Caption.FontSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="{StaticResource TaskBarStatusNameMargin}" />
  </Style>
  <Style Selector="TextBlock.TaskBarStatusValue">
    <Setter Property="Foreground" Value="{DynamicResource SemiColorDanger}" />
    <Setter Property="FontSize" Value="{StaticResource Kudo.Typography.Caption.FontSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Width" Value="{StaticResource TaskBarStatusValueWidth}" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.TaskBarStatusValue.Online">
    <Setter Property="Foreground" Value="{DynamicResource SemiColorSuccess}" />
  </Style>
</Styles>
