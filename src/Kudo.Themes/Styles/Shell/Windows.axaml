<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:codewf="https://codewf.com" xmlns:u="https://irihi.tech/ursa">
  <Style Selector="codewf|CodeWFWindow.ShellWindow">
    <Setter Property="TitleBarHeight" Value="{StaticResource ShellTitleBarHeight}" />
    <Setter Property="TitleBarBackground" Value="Transparent" />
    <Setter Property="TitleBarBorderThickness" Value="0" />
    <Setter Property="TitleBarForeground" Value="{DynamicResource ShellTitleBarForeground}" />
    <Setter Property="WindowCornerRadius" Value="{StaticResource ShellWindowCornerRadius}" />
    <Setter Property="Background" Value="{DynamicResource SemiColorBackground0}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="codewf|CodeWFWindow.AppDialogWindow">
    <Setter Property="TitleBarHeight" Value="{StaticResource UnifiedDialogTitleBarHeight}" />
    <Setter Property="TitleBarBackground" Value="{DynamicResource Kudo.Dialog.Header.Background}" />
    <Setter Property="TitleBarBorderThickness" Value="{StaticResource Kudo.Dialog.Business.TitleBarBorderThickness}" />
    <Setter Property="TitleBarBorderBrush" Value="{DynamicResource SemiColorBorder}" />
    <Setter Property="TitleBarForeground" Value="{DynamicResource DialogTitleBarForeground}" />
    <Setter Property="WindowCornerRadius" Value="{StaticResource ShellWindowCornerRadius}" />
    <Setter Property="Background" Value="{DynamicResource SemiColorBackground0}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="codewf|CodeWFWindow.BusinessDialogWindow">
    <Setter Property="TitleBarHeight" Value="{StaticResource UnifiedDialogTitleBarHeight}" />
    <Setter Property="TitleBarBackground" Value="{DynamicResource Kudo.Dialog.Header.Background}" />
    <Setter Property="TitleBarBorderThickness" Value="{StaticResource Kudo.Dialog.Business.TitleBarBorderThickness}" />
    <Setter Property="TitleBarBorderBrush" Value="{DynamicResource SemiColorBorder}" />
    <Setter Property="TitleBarForeground" Value="{DynamicResource SemiColorText0}" />
    <Setter Property="WindowCornerRadius" Value="{StaticResource Kudo.Dialog.Business.WindowCornerRadius}" />
    <Setter Property="Background" Value="{DynamicResource SemiColorBackground0}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="codewf|CodeWFWindow.LoginWindow">
    <Setter Property="TitleBarHeight" Value="{StaticResource LoginTitleBarHeight}" />
    <Setter Property="TitleBarBackground" Value="Transparent" />
    <Setter Property="TitleBarBorderThickness" Value="0" />
    <Setter Property="TitleBarForeground" Value="{DynamicResource ShellTitleBarForeground}" />
    <Setter Property="WindowCornerRadius" Value="{StaticResource ShellWindowCornerRadius}" />
    <Setter Property="Background" Value="{DynamicResource SemiColorBackground0}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LoginWindowBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
</Styles>
