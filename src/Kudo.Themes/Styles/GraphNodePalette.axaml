<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:arc="https://github.com/AIDotNet/TKCode.Arc">
    <Style Selector="Border.graph-node-palette-root">
        <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
    </Style>
    <Style Selector="TextBlock.graph-node-palette-title">
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Styles.Resources>
        <ResourceDictionary>
            <!-- Arc 全局 TextBox 主题是自绘 Field 管线，普通 TextBox 在缺资源的宿主里会渲染成隐形；
                 此处为模型库搜索框提供自包含模板，保证任何主题环境下都可见。 -->
            <ControlTheme x:Key="GraphPaletteSearchTheme" TargetType="TextBox" x:DataType="TextBox">
                <Setter Property="Background" Value="{DynamicResource SemiColorBackground0}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SemiColorText3}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="8,0,28,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CaretBrush" Value="{DynamicResource SemiColorText0}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource SemiColorPrimaryLightActive}" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="PART_BorderElement"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Panel Margin="{TemplateBinding Padding}">
                                <TextPresenter Name="PART_TextPresenter"
                                               Text="{TemplateBinding Text}"
                                               TextAlignment="{TemplateBinding TextAlignment}"
                                               CaretBrush="{TemplateBinding CaretBrush}"
                                               VerticalAlignment="Center" />
                                <TextBlock IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                           Text="{TemplateBinding PlaceholderText}"
                                           FontSize="12"
                                           Foreground="#747C78"
                                           VerticalAlignment="Center" />
                                <PathIcon Width="14"
                                          Height="14"
                                          Margin="0,0,8,0"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Foreground="{DynamicResource SemiColorText2}"
                                          Data="{DynamicResource SemiIconSearchStroked}" />
                            </Panel>
                        </Border>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>
    <Style Selector="TextBox.graph-node-palette-search">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Theme" Value="{StaticResource GraphPaletteSearchTheme}" />
    </Style>
    <Style Selector="PathIcon.graph-node-palette-search-icon">
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
    </Style>
    <Style Selector="Button.graph-node-palette-group">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
    </Style>
    <Style Selector="Button.graph-node-palette-group:pointerover, Button.graph-node-palette-group.selected">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
    </Style>
    <Style Selector="TextBlock.graph-node-palette-group-icon">
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="GridSplitter.graph-node-palette-splitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate TargetType="GridSplitter">
                <Grid Background="Transparent">
                    <Border Height="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SemiColorBorder}" />
                    <Border Width="36"
                            Height="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SemiColorText3}"
                            CornerRadius="1" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.graph-node-palette-model">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="80" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="MinHeight" Value="80" />
        <Setter Property="Padding" Value="1,3" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.graph-node-palette-model:pointerover">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
    </Style>
    <Style Selector="Border.graph-node-palette-icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="Border.graph-node-palette-icon TextBlock">
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
    </Style>
    <Style Selector="TextBlock.graph-node-palette-model-title">
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextTrimming" Value="None" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
</Styles>
