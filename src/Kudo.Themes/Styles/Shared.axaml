<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="https://github.com/AIDotNet/TKCode.Arc">
  <Design.PreviewWith>
    <Border Padding="20">
      <!-- Add Controls for Previewer Here -->
    </Border>
  </Design.PreviewWith>

  <!-- Add Styles Here -->
  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource NotoSansSC}" />
    <Setter Property="FontSize" Value="{StaticResource Kudo.Typography.Caption.FontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
  </Style>
  <Style Selector="ToolTip /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource ToolTipForeground}" />
  </Style>
  <Style Selector="ToolTip TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ToolTipForeground}" />
  </Style>
  <Style Selector="SelectableTextBlock">
    <Setter Property="FontFamily" Value="{StaticResource NotoSansSC}" />
    <Setter Property="FontSize" Value="{StaticResource Kudo.Typography.Caption.FontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource NotoSansSC}" />
    <Setter Property="FontSize" Value="{StaticResource Kudo.Typography.Caption.FontSize}" />
  </Style>
  <Style Selector="Button">
    <Setter Property="FontFamily" Value="{StaticResource NotoSansSC}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource NotoSansSC}" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="FontFamily" Value="{StaticResource NotoSansSC}" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="FontFamily" Value="{StaticResource NotoSansSC}" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource NotoSansSC}" />
  </Style>
  <Style Selector="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource NotoSansSC}" />
  </Style>
  <Style Selector="TreeView">
    <Setter Property="Background" Value="{DynamicResource SemiColorBackground0}" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
  </Style>
  <Style Selector="TreeViewItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
  </Style>
  <Style Selector="TreeViewItem:pointerover">
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
    <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
  </Style>
  <Style Selector="TreeViewItem:selected">
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
  </Style>
  <Style Selector="TreeViewItem TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
  </Style>
  <Style Selector="TreeViewItem:pointerover TextBlock">
    <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
  </Style>
  <Style Selector="TreeViewItem:selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
  </Style>
  <Style Selector="Border.EmptyState">
    <Setter Property="Background" Value="{DynamicResource SemiColorBackground0}" />
    <Setter Property="Padding" Value="{StaticResource Kudo.Layout.Spacing.Control.Enormous}" />
  </Style>
  <Style Selector="StackPanel.EmptyStatePanel">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Spacing" Value="8" />
  </Style>
  <Style Selector="TextBlock.EmptyStateTitle">
    <Setter Property="Foreground" Value="{DynamicResource Colors.Title}" />
    <Setter Property="FontSize" Value="{StaticResource Kudo.Typography.Header.FontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource Kudo.Typography.Emphasis.FontWeight}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.EmptyStateDescription">
    <Setter Property="Foreground" Value="{DynamicResource Colors.Secondary.Text}" />
    <Setter Property="FontSize" Value="{StaticResource Kudo.Typography.Caption.FontSize}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="MaxWidth" Value="320" />
  </Style>
</Styles>
