<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(KudoTargetFrameworks)</TargetFrameworks>
		<LangVersion>preview</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>true</IsPackable>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<Description>Kudo 画布、设计器与桌面控件的统一主题资源。</Description>
	</PropertyGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\Fonts\*" />
		<AvaloniaResource Include="Assets\*.png" />
		<AvaloniaResource Include="Assets\Brand\*.png" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" />
		<PackageReference Include="Semi.Avalonia" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Kudo.Avalonia\Kudo.Avalonia.csproj" />
		<ProjectReference Include="..\Kudo.Controls\Kudo.Controls.csproj" />
	</ItemGroup>
</Project>
