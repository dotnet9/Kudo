<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(KudoTargetFrameworks)</TargetFrameworks>
		<LangVersion>preview</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>true</IsPackable>
		<!--禁用自动生成程序集属性-->
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
	  <AvaloniaResource Include="Assets\info-64x64.png" />
	  <AvaloniaResource Include="Assets\no-register-background.png" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" />
		<PackageReference Include="CodeWF.Avalonia.Controls" />
		<PackageReference Include="Irihi.Ursa" />
		<PackageReference Include="ReactiveUI.Avalonia" />
		<PackageReference Include="CodeWF.Avalonia.Log" />
		<PackageReference Include="Prism.DryIoc.Avalonia" />
		<PackageReference Include="CodeWF.Toolkit.EventBus" />
		<PackageReference Include="CodeWF.Toolkit.Core" />
		<PackageReference Include="VC-LTL" />
	</ItemGroup>
</Project>
