<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Padding="20">
      <!-- Add Controls for Previewer Here -->
    </Border>
  </Design.PreviewWith>

  <!-- 主数据表默认使用 30px 行高和 14px 字号。 -->
  <Style Selector="DataGrid">
    <Setter Property="FontFamily" Value="{StaticResource NotoSansSC}" />
    <Setter Property="BorderBrush" Value="#F0F0F0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0,0,4,4" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="#F0F0F0" />
    <Setter Property="VerticalGridLinesBrush" Value="#F0F0F0" />
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="FontSize" Value="{DynamicResource DataGridLargeFontSize}" />
    <Setter Property="RowHeight" Value="{DynamicResource DataGridLargeHeight}" />
    <Setter Property="ColumnHeaderHeight" Value="{DynamicResource DataGridLargeHeight}" />
    <Setter Property="Foreground" Value="#262626" />
    <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
    <Setter Property="Classes.InsetContent" Value="True" />
    <Setter Property="CanUserReorderColumns" Value="True" />
    <Setter Property="CanUserResizeColumns" Value="True" />
    <Setter Property="CanUserSortColumns" Value="True" />
    <Setter Property="Background" Value="White" />
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource DataGridColumnHeaderBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource DataGridColumnHeaderForeground}" />
    <Setter Property="MinHeight" Value="{DynamicResource DataGridLargeHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource DataGridLargeFontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource Kudo.Typography.Emphasis.FontWeight}" />
    <Setter Property="Padding" Value="{DynamicResource DataGridColumnHeaderPadding}" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="DataGridColumnHeader /template/ ContentPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource DataGridColumnHeaderForeground}" />
    <Setter Property="TextElement.FontSize" Value="{DynamicResource DataGridLargeFontSize}" />
  </Style>
  <Style Selector="DataGridColumnHeader /template/ TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DataGridColumnHeaderForeground}" />
    <Setter Property="FontSize" Value="{DynamicResource DataGridLargeFontSize}" />
  </Style>
  <Style Selector="DataGridCell">
    <Setter Property="MinHeight" Value="{DynamicResource DataGridLargeHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource DataGridLargeFontSize}" />
  </Style>
  <Style Selector="DataGridCell TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource DataGridLargeFontSize}" />
  </Style>
  <Style Selector="DataGridCell TextBox">
    <Setter Property="Height" Value="{DynamicResource DataGridLargeHeight}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource DataGridLargeFontSize}" />
    <Setter Property="Padding" Value="{DynamicResource DataGridCellEditorPadding}" />
    <Setter Property="Background" Value="{DynamicResource SemiColorBackground0}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="DataGridCell ComboBox">
    <Setter Property="Height" Value="{DynamicResource DataGridLargeHeight}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource DataGridLargeFontSize}" />
    <Setter Property="Padding" Value="{DynamicResource DataGridCellEditorPadding}" />
    <Setter Property="Background" Value="{DynamicResource SemiColorBackground0}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="DataGridCell ComboBoxItem">
    <Setter Property="FontSize" Value="{DynamicResource DataGridLargeFontSize}" />
  </Style>
  <Style Selector="DataGridCell CheckBox">
    <Setter Property="FontSize" Value="{DynamicResource DataGridLargeFontSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="DataGridCell Button">
    <Setter Property="FontSize" Value="{DynamicResource DataGridLargeFontSize}" />
  </Style>
  <Style Selector="DataGridCell NumericUpDown">
    <Setter Property="Height" Value="{DynamicResource DataGridLargeHeight}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource DataGridLargeFontSize}" />
    <Setter Property="Background" Value="{DynamicResource SemiColorBackground0}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- 全局 DataGrid 行交互态 -->
  <Style Selector="DataGridRow">
    <Setter Property="MinHeight" Value="{DynamicResource DataGridLargeHeight}" />
  </Style>

  <!-- 详情侧栏等紧凑数据表显式使用 Small 类：28px 行高、12px 字号。 -->
  <Style Selector="DataGrid.Small">
    <Setter Property="FontSize" Value="{DynamicResource DataGridSmallFontSize}" />
    <Setter Property="RowHeight" Value="{DynamicResource DataGridSmallHeight}" />
    <Setter Property="ColumnHeaderHeight" Value="{DynamicResource DataGridSmallHeight}" />
  </Style>
  <Style Selector="DataGrid.Small DataGridColumnHeader">
    <Setter Property="MinHeight" Value="{DynamicResource DataGridSmallHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource DataGridSmallFontSize}" />
  </Style>
  <Style Selector="DataGrid.Small DataGridColumnHeader /template/ ContentPresenter">
    <Setter Property="TextElement.FontSize" Value="{DynamicResource DataGridSmallFontSize}" />
  </Style>
  <Style Selector="DataGrid.Small DataGridColumnHeader /template/ TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource DataGridSmallFontSize}" />
  </Style>
  <Style Selector="DataGrid.Small DataGridRow">
    <Setter Property="MinHeight" Value="{DynamicResource DataGridSmallHeight}" />
  </Style>
  <Style Selector="DataGrid.Small DataGridCell">
    <Setter Property="MinHeight" Value="{DynamicResource DataGridSmallHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource DataGridSmallFontSize}" />
  </Style>
  <Style Selector="DataGrid.Small DataGridCell TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource DataGridSmallFontSize}" />
  </Style>
  <Style Selector="DataGrid.Small DataGridCell TextBox">
    <Setter Property="Height" Value="{DynamicResource DataGridSmallHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource DataGridSmallFontSize}" />
  </Style>
  <Style Selector="DataGrid.Small DataGridCell ComboBox">
    <Setter Property="Height" Value="{DynamicResource DataGridSmallHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource DataGridSmallFontSize}" />
  </Style>
  <Style Selector="DataGrid.Small DataGridCell ComboBoxItem">
    <Setter Property="FontSize" Value="{DynamicResource DataGridSmallFontSize}" />
  </Style>
  <Style Selector="DataGrid.Small DataGridCell CheckBox">
    <Setter Property="FontSize" Value="{DynamicResource DataGridSmallFontSize}" />
  </Style>
  <Style Selector="DataGrid.Small DataGridCell Button">
    <Setter Property="FontSize" Value="{DynamicResource DataGridSmallFontSize}" />
  </Style>
  <Style Selector="DataGrid.Small DataGridCell NumericUpDown">
    <Setter Property="Height" Value="{DynamicResource DataGridSmallHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource DataGridSmallFontSize}" />
  </Style>

  <Style Selector="DataGridRow:pointerover /template/ Border#BackgroundBorder">
    <Setter Property="Background" Value="{DynamicResource DataGridRowPointeroverBackground}" />
  </Style>
  <Style Selector="DataGridRow:selected">
    <Setter Property="Foreground" Value="{DynamicResource DataGridRowSelectedForeground}" />
  </Style>
  <Style Selector="DataGridRow:selected /template/ Border#BackgroundBorder">
    <Setter Property="Background" Value="{DynamicResource DataGridRowSelectedBackground}" />
  </Style>
  <Style Selector="DataGridRow:selected:pointerover /template/ Border#BackgroundBorder">
    <Setter Property="Background" Value="{DynamicResource DataGridRowSelectedPointeroverBackground}" />
  </Style>
  <!-- 交互背景只绘制到 Semi 行模板的 BackgroundBorder：既保留选中行分隔线，
       也避免给单元格着色后因虚拟化复用出现局部残留。 -->
</Styles>
