<Styles x:Class="Kudo.AvaloniaCommon.Themes.CommonTheme"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StyleInclude Source="/Themes/_index.axaml" />
  <StyleInclude Source="/Styles/_index.axaml" />
  <StyleInclude Source="avares://Kudo.Controls/Styles/_index.axaml" />
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Kudo.AvaloniaCommon/Converters/_index.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
</Styles>