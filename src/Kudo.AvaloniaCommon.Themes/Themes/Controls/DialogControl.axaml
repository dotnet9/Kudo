<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:u="https://irihi.tech/ursa"
  xmlns:iri="https://irihi.tech/shared">
  <ControlTheme x:Key="{x:Type u:CustomDialogControl}" TargetType="u:CustomDialogControl">
    <Setter Property="MinWidth" Value="{DynamicResource DialogMinWidth}" />
    <Setter Property="MinHeight" Value="{DynamicResource DialogMinHeight}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Kudo.Dialog.CornerRadius}" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform"
                                       Duration="{StaticResource MotionDurationStandard}" />
      </Transitions>
    </Setter>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="RenderTransform" Value="scale(1.0)" />
    <Setter Property="Template">
      <ControlTemplate TargetType="u:CustomDialogControl">
        <Panel>
          <Border
            Name="PART_Border"
            Padding="0"
            HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
            VerticalAlignment="{TemplateBinding VerticalAlignment}"
            Background="{DynamicResource SemiColorBackground2}"
            Classes="Shadow"
            ClipToBounds="False"
            CornerRadius="{TemplateBinding CornerRadius}"
            Focusable="True"
            IsHitTestVisible="True"
            Theme="{DynamicResource CardBorder}">
            <Border ClipToBounds="True" CornerRadius="{TemplateBinding CornerRadius}">
              <Grid RowDefinitions="Auto, *">
                <ScrollViewer
                  Grid.Row="0"
                  Grid.RowSpan="2"
                  HorizontalScrollBarVisibility="{Binding (ScrollViewer.HorizontalScrollBarVisibility), RelativeSource={RelativeSource TemplatedParent}}"
                  VerticalScrollBarVisibility="{Binding (ScrollViewer.VerticalScrollBarVisibility), RelativeSource={RelativeSource TemplatedParent}}">
                  <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" />
                </ScrollViewer>
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                  <Panel
                    Name="{x:Static u:DialogControlBase.PART_TitleArea}"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Background="Transparent" />
                  <Button
                    Name="{x:Static u:MessageBoxWindow.PART_CloseButton}"
                    Grid.Column="1"
                    Width="24"
                    Height="24"
                    Margin="0,12,16,0"
                    DockPanel.Dock="Right"
                    Theme="{DynamicResource OverlayCloseButton}" />
                </Grid>
              </Grid>
            </Border>
          </Border>
          <u:DialogResizer Margin="{Binding #PART_Border.Margin}" IsVisible="{TemplateBinding CanResize}" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:full-screen">
      <Setter Property="CornerRadius" Value="0" />
      <Style Selector="^ /template/ Border#PART_Border">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Theme" Value="{x:Null}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="{DynamicResource BorderCardBackground}" />
      </Style>
    </Style>
    <Style Selector="^ /template/ Panel#PART_TitleArea">
      <Setter Property="ContextFlyout">
        <MenuFlyout>
          <MenuItem Command="{Binding $parent[u:DialogControlBase].Close}"
                    Header="{DynamicResource STRING_MENU_DIALOG_CLOSE}">
            <MenuItem.Icon>
              <PathIcon Data="{DynamicResource SemiIconClose}" Theme="{StaticResource InnerPathIcon}" />
            </MenuItem.Icon>
          </MenuItem>
        </MenuFlyout>
      </Setter>
    </Style>
    <Style Selector="^:not(:modal) /template/ Panel#PART_TitleArea">
      <Setter Property="ContextFlyout">
        <MenuFlyout>
          <MenuItem
            Command="{Binding $parent[u:DialogControlBase].UpdateLayer}"
            CommandParameter="{x:Static u:DialogLayerChangeType.BringForward}"
            Header="{DynamicResource STRING_MENU_BRING_FORWARD}">
            <MenuItem.Icon>
              <PathIcon Data="{DynamicResource DialogArrangeBringForwardGlyph}"
                        Theme="{StaticResource InnerPathIcon}" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem
            Command="{Binding $parent[u:DialogControlBase].UpdateLayer}"
            CommandParameter="{x:Static u:DialogLayerChangeType.BringToFront}"
            Header="{DynamicResource STRING_MENU_BRING_TO_FRONT}">
            <MenuItem.Icon>
              <PathIcon Data="{DynamicResource DialogArrangeBringToFrontGlyph}"
                        Theme="{StaticResource InnerPathIcon}" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem
            Command="{Binding $parent[u:DialogControlBase].UpdateLayer}"
            CommandParameter="{x:Static u:DialogLayerChangeType.SendBackward}"
            Header="{DynamicResource STRING_MENU_SEND_BACKWARD}">
            <MenuItem.Icon>
              <PathIcon Data="{DynamicResource DialogArrangeSendBackwardGlyph}"
                        Theme="{StaticResource InnerPathIcon}" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem
            Command="{Binding $parent[u:DialogControlBase].UpdateLayer}"
            CommandParameter="{x:Static u:DialogLayerChangeType.SendToBack}"
            Header="{DynamicResource STRING_MENU_SEND_TO_BACK}">
            <MenuItem.Icon>
              <PathIcon Data="{DynamicResource DialogArrangeSendToBackGlyph}"
                        Theme="{StaticResource InnerPathIcon}" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Command="{Binding $parent[u:DialogControlBase].Close}"
                    Header="{DynamicResource STRING_MENU_DIALOG_CLOSE}">
            <MenuItem.Icon>
              <PathIcon Data="{DynamicResource SemiIconClose}" Theme="{StaticResource InnerPathIcon}" />
            </MenuItem.Icon>
          </MenuItem>
        </MenuFlyout>
      </Setter>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type u:StandardDialogControl}" TargetType="u:StandardDialogControl">
    <Setter Property="MinWidth" Value="{DynamicResource DialogMinWidth}" />
    <Setter Property="MinHeight" Value="{DynamicResource DialogMinHeight}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Kudo.Dialog.CornerRadius}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0.2" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="u:StandardDialogControl">
        <Panel>
          <Border
            Name="PART_Border"
            Padding="0"
            HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
            VerticalAlignment="{TemplateBinding VerticalAlignment}"
            Background="{DynamicResource DialogBackground}"
            BoxShadow="{DynamicResource Kudo.Dialog.BoxShadow}"
            Classes="Shadow"
            ClipToBounds="False"
            CornerRadius="{TemplateBinding CornerRadius}"
            Focusable="True"
            IsHitTestVisible="True"
            Theme="{DynamicResource CardBorder}">
            <Border ClipToBounds="True" CornerRadius="{TemplateBinding CornerRadius}">
              <Grid RowDefinitions="Auto, *, Auto">
                <Border
                  Name="PART_Header"
                  Grid.Row="0"
                  Height="{StaticResource Kudo.Dialog.Header.Height}"
                  Padding="{StaticResource Kudo.Dialog.Header.Padding}"
                  Background="{DynamicResource Kudo.Dialog.Header.Background}"
                  ClipToBounds="True"
                  CornerRadius="{StaticResource Kudo.Dialog.Header.CornerRadius}">
                  <Grid ColumnDefinitions="Auto, *, Auto">
                    <Panel
                      Name="{x:Static u:DialogControlBase.PART_TitleArea}"
                      Grid.Column="0"
                      Grid.ColumnSpan="3"
                      Background="Transparent" />
                    <PathIcon
                      Name="PART_Icon"
                      Grid.Column="0"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center"
                      Classes="ExtraLarge"
                      Theme="{StaticResource InnerPathIcon}" />
                    <TextBlock
                      Name="PART_Title"
                      Grid.Column="1"
                      VerticalAlignment="Top"
                      FontFamily="{StaticResource NotoSansSC}"
                      FontSize="{StaticResource Kudo.Dialog.Title.FontSize}"
                      FontWeight="{DynamicResource Kudo.Typography.Strong.FontWeight}"
                      Foreground="{DynamicResource Kudo.Text.Primary}"
                      IsHitTestVisible="False"
                      IsVisible="{TemplateBinding Title,
                                                  Converter={x:Static ObjectConverters.IsNotNull}}"
                      LineHeight="{DynamicResource Kudo.Typography.Title.LineHeight}"
                      Text="{TemplateBinding Title}"
                      TextWrapping="Wrap" />
                    <Button
                      Name="{x:Static u:MessageBoxWindow.PART_CloseButton}"
                      Grid.Column="2"
                      VerticalAlignment="Top"
                      Theme="{DynamicResource OverlayCloseButton}" />
                  </Grid>
                </Border>
                <ScrollViewer
                  Grid.Row="1"
                  HorizontalScrollBarVisibility="{Binding (ScrollViewer.HorizontalScrollBarVisibility), RelativeSource={RelativeSource TemplatedParent}}"
                  VerticalScrollBarVisibility="{Binding (ScrollViewer.VerticalScrollBarVisibility), RelativeSource={RelativeSource TemplatedParent}}">
                  <ContentPresenter
                    Name="PART_ContentPresenter"
                    Margin="0"
                    Content="{TemplateBinding Content}" />
                </ScrollViewer>
                <Grid
                  Name="PART_Footer"
                  Grid.Row="2"
                  Margin="{StaticResource Kudo.Dialog.Standard.Footer.Margin}"
                  HorizontalAlignment="Right"
                  ColumnDefinitions="Auto, Auto, Auto, Auto"
                  ColumnSpacing="{StaticResource Kudo.Dialog.Standard.ButtonSpacing}">
                  <Button Name="{x:Static u:StandardDialogControl.PART_CancelButton}" />
                  <Button Name="{x:Static u:StandardDialogControl.PART_NoButton}" />
                  <Button Name="{x:Static u:StandardDialogControl.PART_YesButton}" />
                  <Button Name="{x:Static u:StandardDialogControl.PART_OKButton}" />
                </Grid>
              </Grid>
            </Border>
          </Border>
          <u:DialogResizer Margin="{Binding #PART_Border.Margin}" IsVisible="{TemplateBinding CanResize}" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:full-screen">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="^:full-screen /template/ Border#PART_Border">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Theme" Value="{x:Null}" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="{DynamicResource BorderCardBackground}" />
    </Style>
    <Style Selector="^ /template/ Button#PART_CancelButton">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="iri:ClassHelper.Classes" Value="Tertiary" />
      <Setter Property="Content" Value="{DynamicResource STRING_MENU_DIALOG_CANCEL}" />
    </Style>
    <Style Selector="^ /template/ Button#PART_NoButton">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="iri:ClassHelper.Classes" Value="Danger" />
      <Setter Property="Content" Value="{DynamicResource STRING_MENU_DIALOG_NO}" />
      <Setter Property="Theme" Value="{DynamicResource SolidButton}" />
    </Style>
    <Style Selector="^ /template/ Button#PART_YesButton">
      <Setter Property="Grid.Column" Value="2" />
      <Setter Property="iri:ClassHelper.Classes" Value="Primary" />
      <Setter Property="Content" Value="{DynamicResource STRING_MENU_DIALOG_YES}" />
      <Setter Property="Theme" Value="{DynamicResource SolidButton}" />
    </Style>
    <Style Selector="^ /template/ Button#PART_OKButton">
      <Setter Property="Grid.Column" Value="3" />
      <Setter Property="iri:ClassHelper.Classes" Value="Primary" />
      <Setter Property="Content" Value="{DynamicResource STRING_MENU_DIALOG_OK}" />
      <Setter Property="Theme" Value="{DynamicResource SolidButton}" />
    </Style>
    <Style Selector="^[Mode=None]">
      <Style Selector="^ /template/ PathIcon#PART_Icon">
        <Setter Property="IsVisible" Value="False" />
      </Style>
    </Style>
    <Style Selector="^[Mode=Info] /template/ PathIcon#PART_Icon">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Data" Value="{DynamicResource DialogInformationIconGlyph}" />
      <Setter Property="Foreground" Value="{DynamicResource DialogInfoIconForeground}" />
    </Style>
    <Style Selector="^[Mode=Warning] /template/ PathIcon#PART_Icon">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Data" Value="{DynamicResource DialogWarningIconGlyph}" />
      <Setter Property="Foreground" Value="{DynamicResource DialogWarningIconForeground}" />
    </Style>
    <Style Selector="^[Mode=Error] /template/ PathIcon#PART_Icon">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Data" Value="{DynamicResource DialogErrorIconGlyph}" />
      <Setter Property="Foreground" Value="{DynamicResource DialogErrorIconForeground}" />
    </Style>
    <Style Selector="^[Mode=Question] /template/ PathIcon#PART_Icon">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Data" Value="{DynamicResource DialogQuestionIconGlyph}" />
      <Setter Property="Foreground" Value="{DynamicResource DialogQuestionIconForeground}" />
    </Style>
    <Style Selector="^[Mode=Success] /template/ PathIcon#PART_Icon">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Data" Value="{DynamicResource DialogSuccessIconGlyph}" />
      <Setter Property="Foreground" Value="{DynamicResource DialogSuccessIconForeground}" />
    </Style>
    <Style Selector="^[Mode=Warning] /template/ Button#PART_OKButton,
                        ^[Mode=Warning] /template/ Button#PART_YesButton">
      <Setter Property="iri:ClassHelper.Classes" Value="Warning" />
      <Setter Property="Theme" Value="{DynamicResource SolidButton}" />
    </Style>
    <Style Selector="^[Mode=Warning] /template/ Button#PART_NoButton">
      <Setter Property="iri:ClassHelper.Classes" Value="Danger" />
      <Setter Property="Theme" Value="{DynamicResource SolidButton}" />
    </Style>
    <Style Selector="^[Mode=Error] /template/ Button#PART_OKButton,
                        ^[Mode=Error] /template/ Button#PART_YesButton">
      <Setter Property="iri:ClassHelper.Classes" Value="Danger" />
    </Style>
    <Style Selector="^[Mode=Error] /template/ Button#PART_NoButton">
      <Setter Property="iri:ClassHelper.Classes" Value="Tertiary" />
    </Style>
    <Style Selector="^[Mode=Success] /template/ Button#PART_OKButton,
                        ^[Mode=Success] /template/ Button#PART_YesButton">
      <Setter Property="iri:ClassHelper.Classes" Value="Success" />
    </Style>
    <Style Selector="^ /template/ Panel#PART_TitleArea">
      <Setter Property="ContextFlyout">
        <MenuFlyout>
          <MenuItem Command="{Binding $parent[u:DialogControlBase].Close}"
                    Header="{DynamicResource STRING_MENU_DIALOG_CLOSE}">
            <MenuItem.Icon>
              <PathIcon Data="{DynamicResource SemiIconClose}" Theme="{StaticResource InnerPathIcon}" />
            </MenuItem.Icon>
          </MenuItem>
        </MenuFlyout>
      </Setter>
    </Style>
    <Style Selector="^:not(:modal) /template/ Panel#PART_TitleArea">
      <Setter Property="ContextFlyout">
        <MenuFlyout>
          <MenuItem Command="{Binding $parent[u:DialogControlBase].UpdateLayer}"
                    CommandParameter="{x:Static u:DialogLayerChangeType.BringForward}"
                    Header="{DynamicResource STRING_MENU_BRING_FORWARD}">
            <MenuItem.Icon>
              <PathIcon Data="{DynamicResource DialogArrangeBringForwardGlyph}" Theme="{StaticResource InnerPathIcon}" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Command="{Binding $parent[u:DialogControlBase].UpdateLayer}"
                    CommandParameter="{x:Static u:DialogLayerChangeType.BringToFront}"
                    Header="{DynamicResource STRING_MENU_BRING_TO_FRONT}">
            <MenuItem.Icon>
              <PathIcon Data="{DynamicResource DialogArrangeBringToFrontGlyph}" Theme="{StaticResource InnerPathIcon}" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Command="{Binding $parent[u:DialogControlBase].UpdateLayer}"
                    CommandParameter="{x:Static u:DialogLayerChangeType.SendBackward}"
                    Header="{DynamicResource STRING_MENU_SEND_BACKWARD}">
            <MenuItem.Icon>
              <PathIcon Data="{DynamicResource DialogArrangeSendBackwardGlyph}" Theme="{StaticResource InnerPathIcon}" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Command="{Binding $parent[u:DialogControlBase].UpdateLayer}"
                    CommandParameter="{x:Static u:DialogLayerChangeType.SendToBack}"
                    Header="{DynamicResource STRING_MENU_SEND_TO_BACK}">
            <MenuItem.Icon>
              <PathIcon Data="{DynamicResource DialogArrangeSendToBackGlyph}" Theme="{StaticResource InnerPathIcon}" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Command="{Binding $parent[u:DialogControlBase].Close}"
                    Header="{DynamicResource STRING_MENU_DIALOG_CLOSE}">
            <MenuItem.Icon>
              <PathIcon Data="{DynamicResource SemiIconClose}" Theme="{StaticResource InnerPathIcon}" />
            </MenuItem.Icon>
          </MenuItem>
        </MenuFlyout>
      </Setter>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type u:MessageBoxControl}" TargetType="u:MessageBoxControl">
    <Setter Property="Width" Value="360" />
    <Setter Property="MinWidth" Value="360" />
    <Setter Property="MinHeight" Value="170" />
    <Setter Property="CornerRadius" Value="{DynamicResource Kudo.Dialog.CornerRadius}" />
    <Setter Property="Background" Value="{DynamicResource DialogBackground}" />
    <Setter Property="FontFamily" Value="{StaticResource NotoSansSC}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="{DynamicResource Kudo.Typography.Regular.FontWeight}" />
    <Setter Property="Foreground" Value="#262626" />
    <Setter Property="u:DialogControlBase.CanDragMove" Value="True" />
    <Setter Property="Template">
      <ControlTemplate TargetType="u:MessageBoxControl">
        <Border
          Name="PART_Border"
          Padding="0"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource DialogBackground}"
          BoxShadow="{DynamicResource Kudo.Dialog.BoxShadow}"
          ClipToBounds="False"
          CornerRadius="{TemplateBinding CornerRadius}"
          Focusable="True"
          IsHitTestVisible="True"
          Theme="{DynamicResource CardBorder}">
          <Border.KeyBindings>
            <KeyBinding
              Gesture="Escape"
              Command="{Binding $parent[u:MessageBoxControl].Close}" />
          </Border.KeyBindings>
          <Border ClipToBounds="True" CornerRadius="{TemplateBinding CornerRadius}">
            <Grid RowDefinitions="Auto,Auto,Auto">
              <Grid Grid.Row="0"
                    Margin="21,40,21,0"
                    ColumnDefinitions="32,*,24">
                <Panel
                  Name="{x:Static u:DialogControlBase.PART_TitleArea}"
                  Grid.Column="0"
                  Grid.ColumnSpan="3"
                  Background="Transparent" />
                <Image
                  Name="PART_Icon"
                  Grid.Column="0"
                  Width="32"
                  Height="32"
                  IsHitTestVisible="False"
                  Stretch="Uniform"
                  VerticalAlignment="Center" />
                <TextBlock
                  Name="PART_Title"
                  Grid.Column="1"
                  Margin="10,0,0,0"
                  FontFamily="{StaticResource NotoSansSC}"
                  FontSize="{StaticResource Kudo.Dialog.Title.FontSize}"
                  FontWeight="{DynamicResource Kudo.Typography.Strong.FontWeight}"
                  Foreground="{DynamicResource Kudo.Text.Primary}"
                  IsHitTestVisible="False"
                  LineHeight="{DynamicResource Kudo.Typography.Title.LineHeight}"
                  Text="{TemplateBinding Title}"
                  TextTrimming="CharacterEllipsis"
                  TextWrapping="NoWrap"
                  VerticalAlignment="Center" />
                <Border Grid.Column="2" />
              </Grid>
              <Grid Grid.Row="1" Margin="63,8,35,0">
                <ScrollViewer
                  MaxHeight="300"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
                  <ContentPresenter
                    Name="PART_ContentPresenter"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    FontFamily="{StaticResource NotoSansSC}"
                    FontSize="{DynamicResource Kudo.Typography.Body.FontSize}"
                    FontWeight="{DynamicResource Kudo.Typography.Regular.FontWeight}"
                    Foreground="{DynamicResource Kudo.Text.Primary}"
                    LineHeight="{DynamicResource Kudo.Typography.Body.LineHeight}"
                    TextAlignment="Left"
                    TextWrapping="Wrap"
                    VerticalAlignment="Top" />
                </ScrollViewer>
              </Grid>
              <Grid
                Name="PART_Footer"
                Grid.Row="2"
                Margin="20,24,20,20"
                HorizontalAlignment="Right"
                ColumnDefinitions="Auto,Auto,Auto,Auto"
                ColumnSpacing="{StaticResource Kudo.Dialog.Standard.ButtonSpacing}">
                <Button Name="{x:Static u:MessageBoxControl.PART_CancelButton}" />
                <Button Name="{x:Static u:MessageBoxControl.PART_NoButton}" />
                <Button Name="{x:Static u:MessageBoxControl.PART_YesButton}" />
                <Button Name="{x:Static u:MessageBoxControl.PART_OKButton}" />
              </Grid>
              <Button
                Name="{x:Static u:MessageBoxWindow.PART_CloseButton}"
                Grid.Row="0"
                Width="24"
                Height="24"
                HorizontalAlignment="Right"
                Margin="0,12,16,0"
                Padding="0"
                Theme="{DynamicResource OverlayCloseButton}"
                VerticalAlignment="Top">
                <Image
                  Source="avares://Kudo.AvaloniaCommon.Themes/Assets/dlg-close.png"
                  Width="16"
                  Height="16"
                  IsHitTestVisible="False"
                  Stretch="Uniform" />
              </Button>
            </Grid>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ Button#PART_CancelButton">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="iri:ClassHelper.Classes" Value="Tertiary AppDialogButton" />
      <Setter Property="Content" Value="{DynamicResource STRING_MENU_DIALOG_CANCEL}" />
    </Style>
    <Style Selector="^ /template/ Button#PART_NoButton">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="iri:ClassHelper.Classes" Value="Tertiary AppDialogButton" />
      <Setter Property="Content" Value="{DynamicResource STRING_MENU_DIALOG_CANCEL}" />
      <Setter Property="Theme" Value="{DynamicResource OutlineButton}" />
    </Style>
    <Style Selector="^ /template/ Button#PART_YesButton">
      <Setter Property="Grid.Column" Value="2" />
      <Setter Property="iri:ClassHelper.Classes" Value="Primary AppDialogButton" />
      <Setter Property="Content" Value="{DynamicResource STRING_MENU_DIALOG_OK}" />
      <Setter Property="Theme" Value="{DynamicResource SolidButton}" />
    </Style>
    <Style Selector="^[Buttons=YesNo] /template/ Button#PART_YesButton,
                     ^[Buttons=YesNoCancel] /template/ Button#PART_CancelButton">
      <Setter Property="IsDefault" Value="True" />
    </Style>
    <Style Selector="^ /template/ Button#PART_OKButton">
      <Setter Property="Grid.Column" Value="3" />
      <Setter Property="iri:ClassHelper.Classes" Value="Primary AppDialogButton" />
      <Setter Property="Content" Value="{DynamicResource STRING_MENU_DIALOG_OK}" />
      <Setter Property="Theme" Value="{DynamicResource SolidButton}" />
    </Style>
    <Style Selector="^ /template/ Image#PART_Icon">
      <Setter Property="Source" Value="avares://Kudo.AvaloniaCommon.Themes/Assets/dlg-info.png" />
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^[MessageIcon=Asterisk] /template/ Image#PART_Icon,
                        ^[MessageIcon=Information] /template/ Image#PART_Icon,
                        ^[MessageIcon=Question] /template/ Image#PART_Icon,
                        ^[MessageIcon=Success] /template/ Image#PART_Icon">
      <Setter Property="Source" Value="avares://Kudo.AvaloniaCommon.Themes/Assets/dlg-info.png" />
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^[MessageIcon=Exclamation] /template/ Image#PART_Icon,
                        ^[MessageIcon=Warning] /template/ Image#PART_Icon">
      <Setter Property="Source" Value="avares://Kudo.AvaloniaCommon.Themes/Assets/dlg-warning.png" />
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^[MessageIcon=Error] /template/ Image#PART_Icon,
                        ^[MessageIcon=Hand] /template/ Image#PART_Icon,
                        ^[MessageIcon=Stop] /template/ Image#PART_Icon">
      <Setter Property="Source" Value="avares://Kudo.AvaloniaCommon.Themes/Assets/dlg-important.png" />
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^[MessageIcon=Error] /template/ TextBlock#PART_Title,
                        ^[MessageIcon=Hand] /template/ TextBlock#PART_Title,
                        ^[MessageIcon=Stop] /template/ TextBlock#PART_Title">
      <Setter Property="Foreground" Value="#FF4D4F" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
