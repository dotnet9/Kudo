<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:semi="https://irihi.tech/semi">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="Typography.axaml" />
    <ResourceInclude Source="Layout.axaml" />
  </ResourceDictionary.MergedDictionaries>
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="../Palettes/Default.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="../Palettes/Light.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="../Palettes/Dark.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
    <ResourceDictionary x:Key="{x:Static semi:SemiTheme.Aquatic}">
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="../Palettes/Aquatic.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
    <ResourceDictionary x:Key="{x:Static semi:SemiTheme.Desert}">
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="../Palettes/Desert.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
    <ResourceDictionary x:Key="{x:Static semi:SemiTheme.Dusk}">
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="../Palettes/Dusk.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
    <ResourceDictionary x:Key="{x:Static semi:SemiTheme.NightSky}">
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="../Palettes/NightSky.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
