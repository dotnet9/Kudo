<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.0.0.1</Version>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Authors>Kudo Contributors</Authors>
    <Company>Kudo</Company>
    <RepositoryUrl>https://github.com/dotnet9/Kudo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>模块化图形建模与节点编辑 SDK，提供画布、属性编辑、停靠工作台与导出能力。</Description>
    <PackageTags>kudo;graph;diagram;node-editor;avalonia;modeling</PackageTags>
    <KudoTargetFrameworks Condition="'$(KudoTargetFrameworks)' == '' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(NETCoreSdkVersion)', '^11\.'))">net10.0;net11.0</KudoTargetFrameworks>
    <KudoTargetFrameworks Condition="'$(KudoTargetFrameworks)' == '' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(NETCoreSdkVersion)', '^10\.'))">net10.0</KudoTargetFrameworks>
    <KudoTargetFrameworks Condition="'$(KudoTargetFrameworks)' == ''">net10.0</KudoTargetFrameworks>
    <KudoValidationTargetFramework Condition="'$(KudoValidationTargetFramework)' == '' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(NETCoreSdkVersion)', '^11\.'))">net11.0</KudoValidationTargetFramework>
    <KudoValidationTargetFramework Condition="'$(KudoValidationTargetFramework)' == '' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(NETCoreSdkVersion)', '^10\.'))">net10.0</KudoValidationTargetFramework>
    <KudoValidationTargetFramework Condition="'$(KudoValidationTargetFramework)' == ''">net10.0</KudoValidationTargetFramework>
    <KudoValidationWindowsTargetFramework Condition="'$(KudoValidationWindowsTargetFramework)' == ''">$(KudoValidationTargetFramework)-windows</KudoValidationWindowsTargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md"
          Pack="true"
          PackagePath="\"
          Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)logo.png"
          Pack="true"
          PackagePath="\"
          Visible="false" />
  </ItemGroup>
</Project>
