                                                <k:IconButton x:Name="OpenValidationPanelButton"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.ValidationPanel}}"
                                                        Icon="{lucide:LucideGeometry CircleAlert}"
                                                        IconPlacement="Top"
                                                        Command="{Binding ToggleValidation}" />
                                                <k:IconButton x:Name="OpenDiagnosticsPanelButton"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.Output}}"
                                                        Icon="{lucide:LucideGeometry Terminal}"
                                                        IconPlacement="Top"
                                                        Command="{Binding ToggleDiagnostics}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </WrapPanel>
                                </WrapPanel>
                            </ScrollViewer>
                        </TabStripItem.Tag>
                    </TabStripItem>
                </TabStrip>
            </Grid>
        </Border>
        <Border Grid.Row="1"
                Margin="0"
                Background="#FFFFFF"
                BorderThickness="0"
                CornerRadius="0"
                ClipToBounds="True">
            <ContentControl x:Name="RibbonContent"
                            Height="{StaticResource RibbonMenuContentHeight}"
                            Opacity="1"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Top">
                <ContentControl.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Height" Duration="0:0:0.14" />
                        <DoubleTransition Property="Opacity" Duration="0:0:0.08" />
                    </Transitions>
                </ContentControl.Transitions>
            </ContentControl>
        </Border>
    </Grid>
</UserControl>
