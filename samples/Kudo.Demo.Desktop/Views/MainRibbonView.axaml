<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="using:Avalonia.Automation"
             xmlns:i18n="using:CodeWF.Avalonia.Lang.MarkupExtensions"
             xmlns:helpers="using:Kudo.AvaloniaCommon.Helpers"
             xmlns:lang="using:Localization.Kudo_Demo_Desktop.Views"
             xmlns:models="using:Kudo"
             xmlns:export="using:Kudo.Avalonia.Export"
             xmlns:services="using:Kudo.Demo.Desktop.Services"
             xmlns:views="using:Kudo.Demo.Desktop.Views"
             xmlns:vm="using:Kudo.Demo.Desktop.ViewModels"
             xmlns:k="https://codewf.com"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             x:Class="Kudo.Demo.Desktop.Views.MainRibbonView"
             x:DataType="vm:MainRibbonViewModel">
    <Grid RowDefinitions="32,Auto"
          Background="Transparent"
          ClipToBounds="True">
        <Border x:Name="RibbonHeaderBackground"
                Grid.Row="0"
                Background="{DynamicResource RibbonMenuTabStripBackground}">
            <Grid ColumnDefinitions="Auto,*">
                <Border Grid.Column="0"
                        Classes="QuickToolBarRoot RibbonHeader">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <k:IconButton x:Name="QuickCreateGraphButton"
                                      Classes="QuickToolButton"
                                      Icon="{lucide:LucideGeometry Plus}"
                                      helpers:ToolTipHelper.Text="{i18n:I18n {x:Static lang:MainWindow.NewCanvas}}"
                                      Command="{Binding CreateGraph}" />
                        <k:IconButton x:Name="QuickOpenGraphButton"
                                      Classes="QuickToolButton"
                                      Icon="{lucide:LucideGeometry FolderOpen}"
                                      helpers:ToolTipHelper.Text="{i18n:I18n {x:Static lang:MainWindow.OpenFile}}"
                                      Command="{Binding OpenGraphCommand}" />
                        <k:IconButton x:Name="QuickSaveGraphButton"
                                      Classes="QuickToolButton"
                                      Icon="{lucide:LucideGeometry Save}"
                                      helpers:ToolTipHelper.Text="{i18n:I18n {x:Static lang:MainWindow.SaveCurrentCanvas}}"
                                      Command="{Binding SaveGraphCommand}" />
                    </StackPanel>
                </Border>
                <TabStrip x:Name="RibbonTabs"
                          Classes="RibbonMenuTabs Left"
                          Grid.Column="1"
                          SelectedIndex="0"
                          VerticalAlignment="Top">
                    <TabStripItem Classes="RibbonMenuTab Start" Content="{i18n:I18n {x:Static lang:MainWindow.FileTab}}">
                        <TabStripItem.Tag>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <WrapPanel Classes="RibbonMenuContent Left">
                                    <WrapPanel Classes="RibbonGroup" Orientation="Horizontal">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <k:IconButton x:Name="CopyButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Edit.Copy"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.Copy}}"
                                                        Icon="{lucide:LucideGeometry Copy}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanCopy}"
                                                        helpers:ToolTipHelper.Text="{i18n:I18n {x:Static lang:MainWindow.CopyShortcut}}"
                                                        Command="{Binding ClipboardCommand}"
                                                        CommandParameter="{x:Static services:MainWindowClipboardAction.Copy}" />
                                                <k:IconButton x:Name="CutButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Edit.Cut"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.Cut}}"
                                                        Icon="{lucide:LucideGeometry Scissors}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanCut}"
                                                        helpers:ToolTipHelper.Text="{i18n:I18n {x:Static lang:MainWindow.CutShortcut}}"
                                                        Command="{Binding ClipboardCommand}"
                                                        CommandParameter="{x:Static services:MainWindowClipboardAction.Cut}" />
                                                <k:IconButton x:Name="PasteButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Edit.PasteAsync"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.Paste}}"
                                                        Icon="{lucide:LucideGeometry Download}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanPaste}"
                                                        helpers:ToolTipHelper.Text="{i18n:I18n {x:Static lang:MainWindow.PasteShortcut}}"
                                                        Command="{Binding ClipboardCommand}"
                                                        CommandParameter="{x:Static services:MainWindowClipboardAction.Paste}" />
                                                <k:IconButton x:Name="DuplicateButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Edit.Duplicate"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.Duplicate}}"
                                                        Icon="{lucide:LucideGeometry CopyPlus}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanDuplicate}"
                                                        helpers:ToolTipHelper.Text="{i18n:I18n {x:Static lang:MainWindow.DuplicateShortcut}}"
                                                        Command="{Binding ExecuteDocumentEditAction}"
                                                        CommandParameter="{x:Static services:MainWindowDocumentEditAction.DuplicateSelection}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </WrapPanel>
                                    <Border Classes="RibbonGroupDivider" />
                                    <WrapPanel Classes="RibbonGroup" Orientation="Horizontal">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <k:IconButton x:Name="UndoButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Edit.Undo"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.Undo}}"
                                                        Icon="{lucide:LucideGeometry Undo2}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanUndo}"
                                                        helpers:ToolTipHelper.Text="{Binding Workspace.UndoTip}"
                                                        Command="{Binding ExecuteDocumentEditAction}"
                                                        CommandParameter="{x:Static services:MainWindowDocumentEditAction.Undo}" />
                                                <k:IconButton x:Name="RedoButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Edit.Redo"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.Redo}}"
                                                        Icon="{lucide:LucideGeometry Redo2}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanRedo}"
                                                        helpers:ToolTipHelper.Text="{Binding Workspace.RedoTip}"
                                                        Command="{Binding ExecuteDocumentEditAction}"
                                                        CommandParameter="{x:Static services:MainWindowDocumentEditAction.Redo}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </WrapPanel>
                                    <Border Classes="RibbonGroupDivider" />
                                    <views:DocumentCommandsView />
                                    <Border Classes="RibbonGroupDivider" />
                                    <WrapPanel Classes="RibbonGroup" Orientation="Horizontal">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <k:IconButton x:Name="CloseGraphButton"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.CloseCanvas}}"
                                                        Icon="{lucide:LucideGeometry X}"
                                                        IconPlacement="Top"
                                                        Command="{Binding CloseActiveDocumentCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </WrapPanel>
                                </WrapPanel>
                            </ScrollViewer>
                        </TabStripItem.Tag>
                    </TabStripItem>
                    <TabStripItem Classes="RibbonMenuTab" Content="{i18n:I18n {x:Static lang:MainWindow.ModelingTab}}">
                        <TabStripItem.Tag>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <WrapPanel Classes="RibbonMenuContent Left">
                                    <WrapPanel Classes="RibbonGroup" Orientation="Horizontal">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <k:IconButton x:Name="AddValveNodeButton"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.ValveNode}}"
                                                        Icon="{lucide:LucideGeometry Workflow}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanAddContent}"
                                                        Command="{Binding ExecuteModelingAction}"
                                                        CommandParameter="{x:Static services:MainWindowModelingAction.AddValveNode}" />
                                                <k:IconButton x:Name="AddPumpNodeButton"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.PumpNode}}"
                                                        Icon="{lucide:LucideGeometry Activity}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanAddContent}"
                                                        Command="{Binding ExecuteModelingAction}"
                                                        CommandParameter="{x:Static services:MainWindowModelingAction.AddPumpNode}" />
                                                <k:IconButton x:Name="AddInstrumentNodeButton"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.InstrumentNode}}"
                                                        Icon="{lucide:LucideGeometry Activity}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanAddContent}"
                                                        Command="{Binding ExecuteModelingAction}"
                                                        CommandParameter="{x:Static services:MainWindowModelingAction.AddInstrumentNode}" />
                                                <k:IconButton x:Name="AddAnnotationButton"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.Annotation}}"
                                                        Icon="{lucide:LucideGeometry MessageSquare}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanAddContent}"
                                                        Command="{Binding ExecuteModelingAction}"
                                                        CommandParameter="{x:Static services:MainWindowModelingAction.AddAnnotation}" />
                                                <k:IconButton x:Name="DeleteSelectionButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Edit.Delete"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.DeleteSelection}}"
                                                        Icon="{lucide:LucideGeometry Trash2}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanDeleteSelection}"
                                                        Command="{Binding ExecuteDocumentEditAction}"
                                                        CommandParameter="{x:Static services:MainWindowDocumentEditAction.DeleteSelection}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </WrapPanel>
                                    <Border Classes="RibbonGroupDivider" />
                                    <WrapPanel Classes="RibbonGroup" Orientation="Horizontal">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <k:IconButton x:Name="SelectAllButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Selection.SelectAllNodes"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.SelectAll}}"
                                                        Icon="{lucide:LucideGeometry Check}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanSelectDocumentNodes}"
                                                        helpers:ToolTipHelper.Text="{i18n:I18n {x:Static lang:MainWindow.SelectAllShortcut}}"
                                                        Command="{Binding ExecuteSelectionAction}"
                                                        CommandParameter="{x:Static services:MainWindowSelectionAction.SelectAll}" />
                                                <k:IconButton x:Name="ClearSelectionButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Selection.Clear"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.ClearSelection}}"
                                                        Icon="{lucide:LucideGeometry X}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanClearSelection}"
                                                        helpers:ToolTipHelper.Text="{i18n:I18n {x:Static lang:MainWindow.ClearSelectionShortcut}}"
                                                        Command="{Binding ExecuteSelectionAction}"
                                                        CommandParameter="{x:Static services:MainWindowSelectionAction.Clear}" />
                                                <k:IconButton x:Name="InvertSelectionButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Selection.InvertNodes"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.InvertSelection}}"
                                                        Icon="{lucide:LucideGeometry RefreshCw}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanSelectDocumentNodes}"
                                                        helpers:ToolTipHelper.Text="{i18n:I18n {x:Static lang:MainWindow.InvertSelectionTip}}"
                                                        Command="{Binding ExecuteSelectionAction}"
                                                        CommandParameter="{x:Static services:MainWindowSelectionAction.Invert}" />
                                                <k:IconButton x:Name="SelectSameTypeButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Selection.SelectNodesOfSameType"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.SelectSameType}}"
                                                        Icon="{lucide:LucideGeometry Layers}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanSelectSameType}"
                                                        helpers:ToolTipHelper.Text="{i18n:I18n {x:Static lang:MainWindow.SelectSameTypeTip}}"
                                                        Command="{Binding ExecuteSelectionAction}"
                                                        CommandParameter="{x:Static services:MainWindowSelectionAction.SameType}" />
                                                <k:IconButton x:Name="SelectAdjacentButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Selection.SelectAdjacent"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.SelectAdjacent}}"
                                                        Icon="{lucide:LucideGeometry Link}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanTraverseSelection}"
                                                        helpers:ToolTipHelper.Text="{i18n:I18n {x:Static lang:MainWindow.SelectAdjacentTip}}"
                                                        Command="{Binding ExecuteSelectionAction}"
                                                        CommandParameter="{x:Static services:MainWindowSelectionAction.Adjacent}" />
                                                <k:IconButton x:Name="SelectUpstreamButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Selection.SelectReachable.Upstream"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.SelectUpstream}}"
                                                        Icon="{lucide:LucideGeometry Route}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanTraverseSelection}"
                                                        Command="{Binding ExecuteSelectionAction}"
                                                        CommandParameter="{x:Static services:MainWindowSelectionAction.Upstream}" />
                                                <k:IconButton x:Name="SelectDownstreamButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Selection.SelectReachable.Downstream"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.SelectDownstream}}"
                                                        Icon="{lucide:LucideGeometry Forward}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanTraverseSelection}"
                                                        Command="{Binding ExecuteSelectionAction}"
                                                        CommandParameter="{x:Static services:MainWindowSelectionAction.Downstream}" />
                                                <k:IconButton x:Name="SelectConnectedButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Selection.SelectReachable.Connected"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.SelectBranch}}"
                                                        Icon="{lucide:LucideGeometry GitBranch}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanTraverseSelection}"
                                                        Command="{Binding ExecuteSelectionAction}"
                                                        CommandParameter="{x:Static services:MainWindowSelectionAction.Connected}" />
                                                <k:IconButton x:Name="SelectPathButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Selection.SelectShortestPath"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.SelectPath}}"
                                                        Icon="{lucide:LucideGeometry Link}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanSelectPath}"
                                                        helpers:ToolTipHelper.Text="{i18n:I18n {x:Static lang:MainWindow.SelectPathTip}}"
                                                        Command="{Binding ExecuteSelectionAction}"
                                                        CommandParameter="{x:Static services:MainWindowSelectionAction.ShortestPath}" />
                                                <k:IconButton x:Name="SelectCycleButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Selection.SelectFirstCycle"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.LocateCycles}}"
                                                        Icon="{lucide:LucideGeometry RefreshCw}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanAnalyzeDocument}"
                                                        Command="{Binding ExecuteSelectionAction}"
                                                        CommandParameter="{x:Static services:MainWindowSelectionAction.FirstCycle}" />
                                                <k:IconButton x:Name="SelectSourceNodesButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Selection.SelectNodesByRole.Source"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.SourceNodes}}"
                                                        Icon="{lucide:LucideGeometry CirclePlus}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanAnalyzeDocument}"
                                                        Command="{Binding ExecuteSelectionAction}"
                                                        CommandParameter="{x:Static services:MainWindowSelectionAction.Sources}" />
                                                <k:IconButton x:Name="SelectSinkNodesButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Selection.SelectNodesByRole.Sink"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.SinkNodes}}"
                                                        Icon="{lucide:LucideGeometry Flag}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanAnalyzeDocument}"
                                                        Command="{Binding ExecuteSelectionAction}"
                                                        CommandParameter="{x:Static services:MainWindowSelectionAction.Sinks}" />
                                                <k:IconButton x:Name="SelectIsolatedNodesButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Selection.SelectNodesByRole.Isolated"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.IsolatedNodes}}"
                                                        Icon="{lucide:LucideGeometry CircleAlert}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanAnalyzeDocument}"
                                                        Command="{Binding ExecuteSelectionAction}"
                                                        CommandParameter="{x:Static services:MainWindowSelectionAction.Isolated}" />
                                                <k:IconButton x:Name="SelectCriticalPathButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Selection.SelectCriticalPath"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.CriticalPath}}"
                                                        Icon="{lucide:LucideGeometry MapPin}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanAnalyzeDocument}"
                                                        Command="{Binding ExecuteSelectionAction}"
                                                        CommandParameter="{x:Static services:MainWindowSelectionAction.CriticalPath}" />
                                                <k:IconButton x:Name="SelectViewportButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Selection.SelectNodesInViewport"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.SelectViewport}}"
                                                        Icon="{lucide:LucideGeometry Grid3x3}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanAnalyzeDocument}"
                                                        helpers:ToolTipHelper.Text="{i18n:I18n {x:Static lang:MainWindow.SelectViewportTip}}"
                                                        Command="{Binding ExecuteSelectionAction}"
                                                        CommandParameter="{x:Static services:MainWindowSelectionAction.Viewport}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </WrapPanel>
                                    <Border Classes="RibbonGroupDivider" />
                                    <WrapPanel Classes="RibbonGroup" Orientation="Horizontal">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <k:IconButton x:Name="GroupNodesButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Edit.Group"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.CreateGroup}}"
                                                        Icon="{lucide:LucideGeometry Layers}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanGroup}"
                                                        helpers:ToolTipHelper.Text="{i18n:I18n {x:Static lang:MainWindow.CreateGroupShortcut}}"
                                                        Command="{Binding ExecuteDocumentEditAction}"
                                                        CommandParameter="{x:Static services:MainWindowDocumentEditAction.GroupSelection}" />
                                                <k:IconButton x:Name="UngroupNodesButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Edit.Ungroup"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.Ungroup}}"
                                                        Icon="{lucide:LucideGeometry X}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanUngroup}"
                                                        helpers:ToolTipHelper.Text="{i18n:I18n {x:Static lang:MainWindow.UngroupShortcut}}"
                                                        Command="{Binding ExecuteDocumentEditAction}"
                                                        CommandParameter="{x:Static services:MainWindowDocumentEditAction.UngroupSelection}" />
                                                <k:IconButton x:Name="ToggleGroupCollapsedButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Edit.ToggleGroup"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.CollapseOrExpandGroup}}"
                                                        Icon="{lucide:LucideGeometry UnfoldHorizontal}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanToggleGroup}"
                                                        Command="{Binding ExecuteDocumentEditAction}"
                                                        CommandParameter="{x:Static services:MainWindowDocumentEditAction.ToggleSelectedGroup}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </WrapPanel>
                                    <Border Classes="RibbonGroupDivider" />
                                    <WrapPanel Classes="RibbonGroup" Orientation="Horizontal">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <k:IconButton x:Name="DirectRoutingButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Connections.SetRoutingStyle.Direct"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.Direct}}"
                                                        Icon="{lucide:LucideGeometry Route}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanChangeRouting}"
                                                        Command="{Binding SetRoutingStyle}"
                                                        CommandParameter="{x:Static models:EdgeRoutingStyle.Direct}" />
                                                <k:IconButton x:Name="BezierRoutingButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Connections.SetRoutingStyle.Bezier"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.Bezier}}"
                                                        Icon="{lucide:LucideGeometry GitBranch}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanChangeRouting}"
                                                        Command="{Binding SetRoutingStyle}"
                                                        CommandParameter="{x:Static models:EdgeRoutingStyle.Bezier}" />
                                                <k:IconButton x:Name="OrthogonalRoutingButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Connections.SetRoutingStyle.Orthogonal"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.Orthogonal}}"
                                                        Icon="{lucide:LucideGeometry Link}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanChangeRouting}"
                                                        Command="{Binding SetRoutingStyle}"
                                                        CommandParameter="{x:Static models:EdgeRoutingStyle.Orthogonal}" />
                                                <k:IconButton x:Name="SmartOrthogonalRoutingButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Connections.SetRoutingStyle.SmartOrthogonal"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.SmartOrthogonal}}"
                                                        Icon="{lucide:LucideGeometry Route}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanChangeRouting}"
                                                        Command="{Binding SetRoutingStyle}"
                                                        CommandParameter="{x:Static models:EdgeRoutingStyle.SmartOrthogonal}" />
                                                <k:IconButton x:Name="ManualRoutingButton"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.Manual}}"
                                                        Icon="{lucide:LucideGeometry Route}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanChangeRouting}"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Connections.SetRoutingStyle.Manual"
                                                        Command="{Binding SetRoutingStyle}"
                                                        CommandParameter="{x:Static models:EdgeRoutingStyle.Manual}" />
                                                <k:IconButton x:Name="ClearWaypointsButton"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.ClearWaypoints}}"
                                                        Icon="{lucide:LucideGeometry X}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanChangeRouting}"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Connections.ClearWaypoints"
                                                        Command="{Binding ClearEdgeWaypoints}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </WrapPanel>
                                </WrapPanel>
                            </ScrollViewer>
                        </TabStripItem.Tag>
                    </TabStripItem>
                    <TabStripItem Classes="RibbonMenuTab" Content="{i18n:I18n {x:Static lang:MainWindow.LayoutTab}}">
                        <TabStripItem.Tag>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <WrapPanel Classes="RibbonMenuContent Left">
                                    <WrapPanel Classes="RibbonGroup" Orientation="Horizontal">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <k:IconButton x:Name="ApplyLayeredLayoutButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Arrangement.ApplyLayered"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.LayeredLayout}}"
                                                        Icon="{lucide:LucideGeometry Layers}"
                                                        IconPlacement="Top"
                                                        IsEnabled="{Binding Workspace.CanZoom}"
                                                        Command="{Binding ExecuteCanvasViewAction}"
                                                        CommandParameter="{x:Static services:MainWindowCanvasViewAction.ApplyLayeredLayout}" />
                                                <k:IconButton x:Name="FitCanvasButton"
                                                        automation:AutomationProperties.AutomationId="GraphEditorContext.Viewport.FitDocument"
                                                        Classes="RibbonCommand"
                                                        Content="{i18n:I18n {x:Static lang:MainWindow.FitCanvas}}"
                                                        Icon="{lucide:LucideGeometry UnfoldHorizontal}"
