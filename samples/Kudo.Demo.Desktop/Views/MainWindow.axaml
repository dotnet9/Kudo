<arc:ArcWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:codewf="https://codewf.com"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:i18n="using:CodeWF.Avalonia.Lang.MarkupExtensions"
                     xmlns:helpers="using:Kudo.Avalonia.Helpers"
                     xmlns:common="using:Localization.Kudo_Demo_Desktop.Application"
                     xmlns:k="https://codewf.com"
                     xmlns:lang="using:Localization.Kudo_Demo_Desktop.Views"
                     xmlns:models="using:Kudo"
                     xmlns:services="using:Kudo.Demo.Desktop.Services"
                     xmlns:views="using:Kudo.Demo.Desktop.Views"
                     xmlns:vm="using:Kudo.Demo.Desktop.ViewModels"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                     xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
                     mc:Ignorable="d"
                     d:DesignWidth="1280"
                     d:DesignHeight="800"
                     x:Class="Kudo.Demo.Desktop.Views.MainWindow"
                     x:DataType="vm:MainWindowViewModel"
                     Title="{i18n:I18n {x:Static lang:MainWindow.WindowTitle}}"
                     Icon="/Assets/logo.ico"
                     Width="1280"
                     Height="800"
                     MinWidth="960"
                     MinHeight="640"
                     Background="{DynamicResource DemoWorkspaceBrush}"
                     ExtendClientAreaToDecorationsHint="True"
                     WindowDecorations="Full"
                     TransparencyLevelHint="None"
                     WindowStartupLocation="CenterScreen">
    <arc:ArcWindow.TitleBar>
        <arc:TitleBar Title="" Background="{DynamicResource DemoHeaderBrush}">
            <arc:TitleBar.LeftContent>
                <StackPanel Classes="ShellTitleBarLeftContent"
                            Margin="8,0,0,0"
                            IsHitTestVisible="False"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Image Classes="ShellTitleBarLogo"
                           Source="/Assets/logo.png"
                           Stretch="Uniform" />
                    <TextBlock x:Name="TitleBarApplicationTitle"
                               Classes="ShellTitleText"
                               Text="Kudo.Avalonia" />
                </StackPanel>
            </arc:TitleBar.LeftContent>
            <arc:TitleBar.RightContent>
                <StackPanel x:Name="TitleBarRightContent"
                            Classes="ShellTitleBarRightContent"
                            Orientation="Horizontal"
                            Spacing="8">
            <Border x:Name="TitleBarDocumentHost"
                    Height="26"
                    VerticalAlignment="Center">
                <TextBlock x:Name="TitleBarDocumentText"
                           Classes="ShellTitleBarRightText"
                           Text="{Binding ActiveDocumentTitle}" />
            </Border>
            <Button x:Name="TitleBarSettingsButton"
                    Classes="ShellTitleBarOptionButton"
                    Click="HandleSettingsClicked"
                    helpers:ToolTipHelper.Text="设置">
                <PathIcon Data="{lucide:LucideGeometry Settings}" />
            </Button>
                </StackPanel>
            </arc:TitleBar.RightContent>
        </arc:TitleBar>
    </arc:ArcWindow.TitleBar>

    <Grid RowDefinitions="*,28">
        <Grid Grid.Row="0"
              RowDefinitions="Auto,*"
              Background="{DynamicResource DemoWorkspaceBrush}"
              ClipToBounds="True">
        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Height="132"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                Background="{DynamicResource DemoHeaderBrush}">
            <Grid ClipToBounds="True">
                <Border Background="{DynamicResource DemoHeaderImageBrush}" />
                <Border Background="{DynamicResource DemoHeaderOverlayBrush}" />
            </Grid>
        </Border>
        <Border Grid.Row="0"
                Classes="ShellMenuHost">
            <views:MainRibbonView x:Name="MainRibbon" />
        </Border>
        <Border Grid.Row="1"
                Margin="8,0,8,4"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="0"
                ClipToBounds="True">
            <Grid>
                <arc:DockLayout x:Name="WorkspaceDock"
                                IsVisible="False">
                    <arc:DockLayout.Workspace>
                        <arc:DockWorkspace>
                            <!-- 原版布局：左 18%（任务管理器/模型库页签组）· 中 60% 文档区 · 右 22% 属性 · 底 22% 日志组 -->
                            <arc:DockSplit Orientation="Vertical">
                                <arc:DockSplit Orientation="Horizontal" Size="78">
                                    <arc:DockGroup Size="18">
                                        <arc:DockPane Id="GraphToolbox"
                                                      Title="{i18n:I18n {x:Static lang:MainWindow.ModelLibrary}}"
                                                      CanClose="False"
                                                      CanFloat="True"
                                                      CanAutoHide="True">
                                            <ContentControl x:Name="ToolboxHost" />
                                        </arc:DockPane>
                                        <arc:DockPane Id="GraphDocumentsTool"
                                                      Title="{i18n:I18n {x:Static lang:MainWindow.TaskManager}}"
                                                      CanClose="False"
                                                      CanFloat="True"
                                                      CanAutoHide="True">
                                            <ContentControl x:Name="DocumentsHost" />
                                        </arc:DockPane>
                                    </arc:DockGroup>
                                    <arc:DockDocumentArea Size="60">
                                        <arc:DockGroup />
                                    </arc:DockDocumentArea>
                                    <arc:DockGroup Size="22">
                                        <arc:DockPane Id="GraphProperties"
                                                      Title="{i18n:I18n {x:Static lang:MainWindow.Properties}}"
                                                      CanClose="False"
                                                      CanFloat="True"
                                                      CanAutoHide="True">
                                            <ContentControl x:Name="PropertiesHost" />
                                        </arc:DockPane>
                                    </arc:DockGroup>
                                </arc:DockSplit>
                                <arc:DockGroup Size="22">
                                    <arc:DockPane Id="GraphDiagnostics"
                                                  Title="{i18n:I18n {x:Static lang:MainWindow.Output}}"
                                                  CanClose="False"
                                                  CanFloat="True"
                                                  CanAutoHide="True">
                                        <ContentControl x:Name="DiagnosticsHost" />
                                    </arc:DockPane>
                                    <arc:DockPane Id="GraphValidation"
                                                  Title="{i18n:I18n {x:Static lang:MainWindow.ValidationPanel}}"
                                                  CanClose="False"
                                                  CanFloat="True"
                                                  CanAutoHide="True">
                                        <ContentControl x:Name="ValidationHost" />
                                    </arc:DockPane>
                                    <arc:DockPane Id="GraphRuntimeVariables"
                                                  Title="{i18n:I18n {x:Static lang:MainWindow.RuntimeVariables}}"
                                                  CanClose="False"
                                                  CanFloat="True"
                                                  CanAutoHide="True">
                                        <ContentControl x:Name="RuntimeVariablesHost" />
                                    </arc:DockPane>
                                    <arc:DockPane Id="GraphRuntimeBreakpoints"
                                                  Title="{i18n:I18n {x:Static lang:MainWindow.RuntimeBreakpoints}}"
                                                  CanClose="False"
                                                  CanFloat="True"
                                                  CanAutoHide="True">
                                        <ContentControl x:Name="RuntimeBreakpointsHost" />
                                    </arc:DockPane>
                                    <arc:DockPane Id="GraphRuntimeCallStack"
                                                  Title="{i18n:I18n {x:Static lang:MainWindow.RuntimeCallStack}}"
                                                  CanClose="False"
                                                  CanFloat="True"
                                                  CanAutoHide="True">
                                        <ContentControl x:Name="RuntimeCallStackHost" />
                                    </arc:DockPane>
                                    <arc:DockPane Id="GraphRuntimeTrace"
                                                  Title="{i18n:I18n {x:Static lang:MainWindow.RuntimeTrace}}"
                                                  CanClose="False"
                                                  CanFloat="True"
                                                  CanAutoHide="True">
                                        <ContentControl x:Name="RuntimeTraceHost" />
                                    </arc:DockPane>
                                </arc:DockGroup>
                            </arc:DockSplit>
                        </arc:DockWorkspace>
                    </arc:DockLayout.Workspace>
                </arc:DockLayout>
                <k:GraphWorkspaceSkeleton x:Name="WorkspaceSkeleton"
                                          Margin="0" />
            </Grid>
        </Border>
        </Grid>
        <views:StatusBarView Grid.Row="1" />
        <Panel x:Name="CommandPaletteHost"
               Grid.RowSpan="2"
               IsVisible="{Binding IsCommandPaletteOpen}">
            <Border Background="#0A000000" PointerPressed="HandlePaletteBackdropPressed" />
            <Border Width="520"
                    MaxHeight="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,48,0,0"
                    CornerRadius="8"
                    Background="{DynamicResource DemoSurfaceBrush}"
                    BorderBrush="{DynamicResource DemoBorderBrush}"
                    BorderThickness="1">
                <StackPanel Margin="10">
                    <TextBox x:Name="CommandPaletteQuery"
                             Classes="graph-node-palette-search"
                             Watermark="搜索命令（Ctrl+K）" />
                    <ListBox x:Name="CommandPaletteList"
                             Classes="graph-node-palette-list"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="views:PaletteCommand" x:CompileBindings="False">
                                <Grid ColumnDefinitions="*,Auto" Margin="6,3">
                                    <TextBlock Text="{Binding Title}" FontSize="12" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Gesture}"
                                               FontSize="11"
                                               Opacity="0.6" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Panel>
    </Grid>
</arc:ArcWindow>
