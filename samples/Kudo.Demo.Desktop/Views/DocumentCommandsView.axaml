<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:k="https://codewf.com"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:i18n="using:CodeWF.Avalonia.Lang.MarkupExtensions"
             xmlns:helpers="using:Kudo.AvaloniaCommon.Helpers"
             xmlns:lang="using:Localization.Kudo_Demo_Desktop.Views"
             xmlns:vm="using:Kudo.Demo.Desktop.ViewModels"
             x:Class="Kudo.Demo.Desktop.Views.DocumentCommandsView"
             x:DataType="vm:MainRibbonViewModel">
    <WrapPanel Classes="RibbonGroup" Orientation="Horizontal">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <k:IconButton x:Name="NewGraphButton"
                              Classes="RibbonCommand"
                              Content="{i18n:I18n {x:Static lang:MainWindow.NewCanvas}}"
                              Icon="{lucide:LucideGeometry Plus}"
                              IconPlacement="Top"
                              Command="{Binding CreateGraph}" />
                <k:IconButton Classes="RibbonCommand"
                              Content="{i18n:I18n {x:Static lang:MainWindow.OpenFile}}"
                              Icon="{lucide:LucideGeometry FolderOpen}"
                              IconPlacement="Top"
                              Command="{Binding OpenGraphCommand}" />
                <k:IconButton Classes="RibbonCommand"
                              Content="{i18n:I18n {x:Static lang:MainWindow.Save}}"
                              Icon="{lucide:LucideGeometry Save}"
                              IconPlacement="Top"
                              Command="{Binding SaveGraphCommand}" />
                <k:IconButton Classes="RibbonCommand"
                              Content="{i18n:I18n {x:Static lang:MainWindow.SaveAs}}"
                              Icon="{lucide:LucideGeometry Download}"
                              IconPlacement="Top"
                              Command="{Binding SaveGraphAsCommand}" />
                <k:IconButton x:Name="SampleTaskButton"
                                      Classes="RibbonCommand"
                                      Content="{i18n:I18n {x:Static lang:MainWindow.SampleTasks}}"
                                      Icon="{lucide:LucideGeometry Layers}"
                                      IconPlacement="Top"
                                      helpers:ToolTipHelper.Text="{i18n:I18n {x:Static lang:MainWindow.SampleTasksTip}}">
                    <k:IconButton.Styles>
                        <Style x:DataType="vm:DemoSampleTaskMenuItem" Selector="MenuItem">
                            <Setter Property="Header" Value="{Binding Title}" />
                            <Setter Property="Command" Value="{Binding Command}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                            <Setter Property="MinHeight" Value="30" />
                            <Setter Property="Padding" Value="10,4" />
                            <Setter Property="CornerRadius" Value="4" />
                        </Style>
                    </k:IconButton.Styles>
                    <k:IconButton.Flyout>
                        <MenuFlyout ItemsSource="{Binding SampleTasks}" />
                    </k:IconButton.Flyout>
                </k:IconButton>
                <k:IconButton x:Name="LargeGraphButton"
                                      Classes="RibbonCommand"
                                      Content="{i18n:I18n {x:Static lang:MainWindow.PerformanceSample}}"
                                      Icon="{lucide:LucideGeometry LayoutGrid}"
                                      IconPlacement="Top"
                                      helpers:ToolTipHelper.Text="{i18n:I18n {x:Static lang:MainWindow.PerformanceSampleTip}}">
                    <k:IconButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Classes="RibbonFlyoutItem" Header="{i18n:I18n {x:Static lang:MainWindow.NodeCount100}}" Command="{Binding CreateLargeGraphCommand}" CommandParameter="100" />
                            <MenuItem Classes="RibbonFlyoutItem" Header="{i18n:I18n {x:Static lang:MainWindow.NodeCount500}}" Command="{Binding CreateLargeGraphCommand}" CommandParameter="500" />
                            <MenuItem Classes="RibbonFlyoutItem" Header="{i18n:I18n {x:Static lang:MainWindow.NodeCount1000}}" Command="{Binding CreateLargeGraphCommand}" CommandParameter="1000" />
                            <MenuItem Classes="RibbonFlyoutItem" Header="{i18n:I18n {x:Static lang:MainWindow.NodeCount5000}}" Command="{Binding CreateLargeGraphCommand}" CommandParameter="5000" />
                        </MenuFlyout>
                    </k:IconButton.Flyout>
                </k:IconButton>
            </StackPanel>
        </StackPanel>
    </WrapPanel>
</UserControl>
