<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>$(KudoValidationTargetFramework);$(KudoValidationWindowsTargetFramework)</TargetFrameworks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationIcon>..\..\logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="CodeWF.Avalonia.Controls" />
    <PackageReference Include="CodeWF.Toolkit.EventBus" />
    <PackageReference Include="CodeWF.Avalonia.Log" />
    <PackageReference Include="CodeWF.Avalonia.Lang" />
    <PackageReference Include="CodeWF.Toolkit.Lang" />
    <PackageReference Include="CodeWF.Toolkit.Logging" />
    <PackageReference Include="Irihi.Ursa" />
    <PackageReference Include="Irihi.Ursa.Themes.Semi" />
    <ProjectReference Include="..\..\src\Kudo.Controls\Kudo.Controls.csproj" />
    <ProjectReference Include="..\..\src\Kudo.Themes\Kudo.Themes.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="TKCode.Arc" />
    <PackageReference Include="TKCode.Arc.Dock" />
    <PackageReference Include="TKCode.Arc.Icons.Lucide" />
    <PackageReference Include="ReactiveUI.Avalonia" />
    <PackageReference Include="Semi.Avalonia" />
    <PackageReference Include="System.Reactive" />
    <PackageReference Include="System.Drawing.Common" PrivateAssets="all" />
    <PackageReference Include="VC-LTL" />
    <PackageReference Include="YY-Thunks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kudo.Avalonia\Kudo.Avalonia.csproj" />
    <ProjectReference Include="..\Kudo.Demo\Kudo.Demo.csproj" />
    <ProjectReference Include="..\..\src\Kudo.Core\Kudo.Core.csproj" />
    <ProjectReference Include="..\..\src\Kudo.Avalonia.3D\Kudo.Avalonia.3D.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\*.png" />
    <AvaloniaResource Include="..\..\logo.png" Link="Assets\logo.png" />
    <AvaloniaResource Include="..\..\logo.ico" Link="Assets\logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Kudo.Demo.Desktop.config"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Update="I18n\*.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Update="I18n\Language.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>Language.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="I18n\Language.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Language.tt</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Models\**\*"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Update="Samples\**\*"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="Roots.xml" />
  </ItemGroup>
</Project>
