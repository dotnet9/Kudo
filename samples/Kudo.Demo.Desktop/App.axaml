<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com"
             xmlns:k="https://codewf.com"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="Kudo.Demo.Desktop.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <ResourceDictionary>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <semi:SemiTheme Locale="en-US" />
        <semi:UrsaSemiTheme Locale="en-US" />
        <k:KudoTheme />
        <StyleInclude Source="avares://Kudo.Demo.Desktop/Styles/_index.axaml" />
    </Application.Styles>
</Application>
