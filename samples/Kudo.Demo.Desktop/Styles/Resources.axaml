<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <!--
              中性界面色按明暗变体提供（Arc 主题引擎切换 RequestedThemeVariant 时自动生效）；
              品牌性资源（头部渐变/横幅艺术/页签艺术）由 DemoThemeService 按品牌在运行时发布到应用资源。
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="DemoSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DemoWorkspaceBrush" Color="#F2F7F5" />
                    <SolidColorBrush x:Key="DemoBorderBrush" Color="#E3E9E6" />
                    <SolidColorBrush x:Key="DemoTextBrush" Color="#1F2A37" />
                    <SolidColorBrush x:Key="DemoSecondaryTextBrush" Color="#708196" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DemoSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DemoWorkspaceBrush" Color="#F2F7F5" />
                    <SolidColorBrush x:Key="DemoBorderBrush" Color="#E3E9E6" />
                    <SolidColorBrush x:Key="DemoTextBrush" Color="#1F2A37" />
                    <SolidColorBrush x:Key="DemoSecondaryTextBrush" Color="#708196" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="DemoSurfaceBrush" Color="#1E232A" />
                    <SolidColorBrush x:Key="DemoWorkspaceBrush" Color="#16191E" />
                    <SolidColorBrush x:Key="DemoBorderBrush" Color="#2C323B" />
                    <SolidColorBrush x:Key="DemoTextBrush" Color="#E8ECEF" />
                    <SolidColorBrush x:Key="DemoSecondaryTextBrush" Color="#8A94A0" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Color x:Key="CaptionButtonForeground">#FFFFFF</Color>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
