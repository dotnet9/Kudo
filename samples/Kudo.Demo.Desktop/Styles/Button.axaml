<Styles xmlns="https://github.com/avaloniaui"
        xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
        xmlns:k="https://codewf.com">
    <Style Selector="k|IconButton.status-zoom-button">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Foreground" Value="#5F6B7A" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="k|IconButton.status-zoom-button:pointerover">
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
        <Setter Property="Background" Value="#E8F3FF" />
    </Style>
</Styles>
