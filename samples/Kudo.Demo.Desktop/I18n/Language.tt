<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ output extension=".cs" #>
<#@ assembly name="System.Core" #>
<#@ assembly name="System.Text.Json" #>
<#@ assembly name="System.Memory" #>
<#@ assembly name="System.Runtime" #>
<#@ import namespace="System" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text.Json" #>
//------------------------------------------------------------------------------
// <auto-generated>
//     This code was generated by I18n/Language.tt.
//     Changes to this file may cause incorrect behavior and will be lost if
//     the code is regenerated.
// </auto-generated>
//------------------------------------------------------------------------------

<#
    var templateDirectory = Path.GetDirectoryName(Host.TemplateFile)
        ?? throw new InvalidOperationException("Template directory was not found.");
    var jsonFilePath = Directory.GetFiles(templateDirectory, "*.json")
        .OrderBy(file => file, StringComparer.OrdinalIgnoreCase)
        .FirstOrDefault();
    if (jsonFilePath is null)
    {
        throw new InvalidOperationException("No language JSON file was found beside Language.tt.");
    }

    using (var document = JsonDocument.Parse(File.ReadAllText(jsonFilePath)))
    {
        var classNodes = new List<ClassNode>();
        foreach (var rootNode in document.RootElement.EnumerateObject())
        {
            if (IsMetadata(rootNode.Name) || rootNode.Value.ValueKind != JsonValueKind.Object)
            {
                continue;
            }

            CollectClasses(rootNode.Value, new[] { rootNode.Name }, classNodes);
        }

        foreach (var namespaceGroup in classNodes
                     .GroupBy(node => node.Namespace)
                     .OrderBy(group => group.Key, StringComparer.Ordinal))
        {
            WriteLine($"namespace {namespaceGroup.Key}");
            WriteLine("{");
            WriteLine(string.Empty);
            foreach (var classNode in namespaceGroup
                         .GroupBy(node => node.ClassName)
                         .Select(group => group.First())
                         .OrderBy(node => node.ClassName, StringComparer.Ordinal))
            {
                WriteLine($"    public static class {classNode.ClassName}");
                WriteLine("    {");
                foreach (var leaf in classNode.Leaves.OrderBy(leaf => leaf, StringComparer.Ordinal))
                {
                    var fieldName = SanitizeMember(leaf, classNode.ClassName);
                    var fullKey = string.Join(".", classNode.Path.Concat(new[] { leaf }));
                    WriteLine($"        public const string {fieldName} = \"{fullKey}\";");
                }

                WriteLine("    }");
                WriteLine(string.Empty);
            }

            WriteLine("}");
            WriteLine(string.Empty);
        }
    }

    void CollectClasses(JsonElement element, string[] path, List<ClassNode> nodes)
    {
        var leaves = new List<string>();
        foreach (var property in element.EnumerateObject())
        {
            if (property.Value.ValueKind == JsonValueKind.Object)
            {
                CollectClasses(property.Value, path.Concat(new[] { property.Name }).ToArray(), nodes);
            }
            else
            {
                leaves.Add(property.Name);
            }
        }

        if (leaves.Count == 0)
        {
            return;
        }

        var useLanguageClass = path.Length == 1 ||
            (path.Length == 2 && string.Equals(path[0], "Localization", StringComparison.Ordinal));
        var namespaceSegments = useLanguageClass ? path : path.Take(path.Length - 1);
        var className = useLanguageClass ? "Language" : path[path.Length - 1];
        nodes.Add(new ClassNode(
            string.Join(".", namespaceSegments.Select(Sanitize)),
            Sanitize(className),
            path,
            leaves));
    }

    bool IsMetadata(string name)
    {
        return string.Equals(name, "language", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(name, "description", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(name, "cultureName", StringComparison.OrdinalIgnoreCase);
    }

    string Sanitize(string name)
    {
        var chars = name.Where(ch => char.IsLetterOrDigit(ch) || ch == '_').ToArray();
        var sanitized = new string(chars);
        if (string.IsNullOrWhiteSpace(sanitized))
        {
            sanitized = "Unnamed";
        }

        if (char.IsDigit(sanitized[0]))
        {
            sanitized = "_" + sanitized;
        }

        if (CSharpKeywords.Contains(sanitized))
        {
            sanitized = "_" + sanitized;
        }

        return sanitized;
    }

    string SanitizeMember(string name, string className)
    {
        var memberName = Sanitize(name);
        return string.Equals(memberName, className, StringComparison.Ordinal)
            ? memberName + "Key"
            : memberName;
    }
#>
<#+
    sealed class ClassNode
    {
        public ClassNode(
            string @namespace,
            string className,
            IReadOnlyList<string> path,
            IReadOnlyList<string> leaves)
        {
            Namespace = @namespace;
            ClassName = className;
            Path = path;
            Leaves = leaves;
        }

        public string Namespace { get; }

        public string ClassName { get; }

        public IReadOnlyList<string> Path { get; }

        public IReadOnlyList<string> Leaves { get; }
    }

    static readonly HashSet<string> CSharpKeywords = new HashSet<string>(StringComparer.Ordinal)
    {
        "abstract", "as", "base", "bool", "break", "byte", "case", "catch",
        "char", "checked", "class", "const", "continue", "decimal", "default",
        "delegate", "do", "double", "else", "enum", "event", "explicit",
        "extern", "false", "finally", "fixed", "float", "for", "foreach",
        "goto", "if", "implicit", "in", "int", "interface", "internal",
        "is", "lock", "long", "namespace", "new", "null", "object",
        "operator", "out", "override", "params", "private", "protected",
        "public", "readonly", "ref", "return", "sbyte", "sealed", "short",
        "sizeof", "stackalloc", "static", "string", "struct", "switch",
        "this", "throw", "true", "try", "typeof", "uint", "ulong",
        "unchecked", "unsafe", "ushort", "using", "virtual", "void",
        "volatile", "while"
    };
#>
